# =============================================================================
# FUNCIONES — CONFIGURACIÓN DE SWITCH
# =============================================================================

def generar_config_switch(vendor: str, host: str,
                           vlans_config: list,        # lista de dicts {vlan, nombre, ipv4, ipv6}
                           proto_v4: str, proto_v6: str,
                           as_number: int, bgp_neighbor: str, bgp_neighbor_as: int,
                           ospf_router_id: str,
                           cmds_admin_precalc: list,
                           vlan_admin: int, ip_admin: str,
                           modo_ha: str = "Ninguno",
                           ip_respaldo: str = "0.0.0.0",
                           es_activo: bool = True) -> tuple:
    """
    Genera config para un SWITCH con múltiples VLANs.
    vlans_config: lista de dicts con {vlan, nombre, ipv4, ipv6}
    """
    dep, rb = [], []

    if vendor == "Cisco":
        # cmds_admin_precalc ya incluye: enable, crypto key, configure terminal, hostname,
        # vlan admin, SSH config. Solo agregamos DHCP excludes y luego las VLANs de datos.
        dep.extend(cmds_admin_precalc)

        # Excluir gateways e IPs de gestión del pool DHCP de cada VLAN de datos
        dep.append("! ── Exclusiones DHCP (gateways reservados) ──")
        for vc in vlans_config:
            red = ".".join(vc["ipv4"].split('.')[:3])
            dep.append(f"ip dhcp excluded-address {red}.1 {red}.10")

        # Habilitar routing IPv6 global si alguna VLAN lo usa
        if any(vc.get("ipv6") for vc in vlans_config):
            dep.append("ipv6 unicast-routing")

        dep.append("! ── VLANs de datos ──")
        for vc in vlans_config:
            dep.extend([
                f"vlan {vc['vlan']}",
                f" name {vc['nombre']}",
                " exit",
                f"interface vlan {vc['vlan']}",
                f" ip address {vc['ipv4']} {SUBNET_MASK}",
            ])
            if vc.get("ipv6"):
                # Formato correcto: la dirección ya incluye /64, no duplicar
                ipv6_clean = vc['ipv6'] if '/64' in vc['ipv6'] else vc['ipv6'].split('/')[0] + '/64'
                dep.append(f" ipv6 address {ipv6_clean}")
                dep.append(" ipv6 enable")
            dep.extend([
                " no shutdown",
                " exit",
                f"ip dhcp pool POOL_{vc['vlan']}",
                f" network {'.'.join(vc['ipv4'].split('.')[:3])}.0 {SUBNET_MASK}",
                f" default-router {vc['ipv4']}",
                f" dns-server {DNS_PRIMARIO}",
                " exit",
            ])
            dep.extend(cmds_routing_ipv4(vendor, proto_v4, vc["ipv4"], as_number, bgp_neighbor, bgp_neighbor_as, vc["vlan"]))
            dep.extend(cmds_routing_ipv6(vendor, proto_v6, vc.get("ipv6"), as_number, ospf_router_id, vc["vlan"]))
            if modo_ha != "Ninguno":
                dep.extend(cmds_alta_disponibilidad(vendor, vc["vlan"], vc["ipv4"], vc.get("ipv6"), modo_ha, ip_respaldo, es_activo))

        dep.extend(["end", "write memory"])

        for vc in vlans_config:
            rb.extend([f"no ip dhcp pool POOL_{vc['vlan']}", f"no interface vlan {vc['vlan']}", f"no vlan {vc['vlan']}"])
        rb.extend([
            f"no interface vlan {vlan_admin}", f"no vlan {vlan_admin}",
            "no crypto key zeroize rsa", "end", "write memory",
        ])

    elif vendor == "Huawei":
        dep.extend(["system-view", f"sysname {host}"])
        if any(vc.get("ipv6") for vc in vlans_config):
            dep.append("ipv6")
        dep.append("dhcp enable")
        dep.extend(cmds_admin_precalc)

        for vc in vlans_config:
            dep.extend([
                f"vlan {vc['vlan']}",
                f" description {vc['nombre']}",
                " quit",
                f"interface Vlanif{vc['vlan']}",
                f" ip address {vc['ipv4']} {SUBNET_MASK}",
            ])
            if vc.get("ipv6"):
                dep.append(f" ipv6 address {vc['ipv6'].replace('/64', ' 64')}")
            dep.extend([" dhcp select interface", " quit"])
            dep.extend(cmds_routing_ipv4(vendor, proto_v4, vc["ipv4"], as_number, bgp_neighbor, bgp_neighbor_as, vc["vlan"]))
            dep.extend(cmds_routing_ipv6(vendor, proto_v6, vc.get("ipv6"), as_number, ospf_router_id, vc["vlan"]))
            if modo_ha != "Ninguno":
                dep.extend(cmds_alta_disponibilidad(vendor, vc["vlan"], vc["ipv4"], vc.get("ipv6"), modo_ha, ip_respaldo, es_activo))

        dep.extend(["return", "save", "y"])

        for vc in vlans_config:
            rb.extend([f"undo interface Vlanif{vc['vlan']}", f"undo vlan {vc['vlan']}"])
        rb.extend([f"undo interface Vlanif{vlan_admin}", f"undo vlan {vlan_admin}", "return", "save", "y"])

    elif vendor == "Fortinet":
        dep.extend(["config system global", f"    set hostname {host}", "end"])
        dep.extend(cmds_admin_precalc)

        for vc in vlans_config:
            dep.extend([
                "config system interface",
                f"    edit vlan{vc['vlan']}",
                "        set vdom root",
                f"        set ip {vc['ipv4']} {SUBNET_MASK}",
                f"        set vlanid {vc['vlan']}",
                "        set interface internal",
            ])
            if vc.get("ipv6"):
                dep.extend(["        config ipv6", f"            set ip6-address {vc['ipv6']}", "        end"])
            dep.extend(["    next", "end"])
            dep.extend(cmds_routing_ipv4(vendor, proto_v4, vc["ipv4"], as_number, bgp_neighbor, bgp_neighbor_as, vc["vlan"]))
            dep.extend(cmds_routing_ipv6(vendor, proto_v6, vc.get("ipv6"), as_number, ospf_router_id, vc["vlan"]))
            if modo_ha != "Ninguno":
                dep.extend(cmds_alta_disponibilidad(vendor, vc["vlan"], vc["ipv4"], vc.get("ipv6"), modo_ha, ip_respaldo, es_activo))

        rb.extend(["config system interface"])
        for vc in vlans_config:
            rb.append(f"    delete vlan{vc['vlan']}")
        rb.extend([f"    delete vlan{vlan_admin}", "end"])

    return dep, rb


# =============================================================================
# FUNCIONES — CONFIGURACIÓN DE ROUTER
# =============================================================================

def generar_config_router(vendor: str, ipv4: str, ipv6: str | None,
                           host: str, proto_v4: str, proto_v6: str,
                           as_number: int, bgp_neighbor: str,
                           bgp_neighbor_as: int, ospf_router_id: str,
                           cmds_admin_precalc: list,
                           vlan_admin: int, ip_admin: str,
                           modo_ha: str = "Ninguno",
                           ip_respaldo: str = "0.0.0.0",
                           es_activo: bool = True) -> tuple:
    dep, rb = [], []
    ip_wan_gw = f"{IP_BASE_1}.{IP_BASE_2}.{IP_ADMIN_OCTETO}.254"

    if vendor == "Cisco":
        dep.extend(cmds_ssh_router(vendor, host))
        if ipv6:
            dep.append("ipv6 unicast-routing")
        dep.extend([
            "interface GigabitEthernet0/0",
            f" ip address {ipv4} {SUBNET_MASK}",
            " description LAN",
            " no shutdown",
        ])
        if ipv6:
            dep.extend([f" ipv6 address {ipv6.split('/')[0]}/64", " ipv6 enable"])
        dep.extend([
            " exit",
            "interface GigabitEthernet0/1",
            f" ip address {ip_wan_gw} {SUBNET_MASK}",
            " description WAN", " no shutdown", " exit",
            f"ip route 0.0.0.0 0.0.0.0 {ip_wan_gw}",
        ])
        dep.extend(cmds_routing_ipv4(vendor, proto_v4, ipv4, as_number, bgp_neighbor, bgp_neighbor_as))
        dep.extend(cmds_routing_ipv6(vendor, proto_v6, ipv6, as_number, ospf_router_id))
        if modo_ha in ("IP SLA + Ruta Flotante", "Completo"):
            dep.extend([
                f"ip sla {IPSLA_NUM}",
                f" icmp-echo {ip_respaldo} source-interface GigabitEthernet0/0",
                " frequency 5", " exit",
                f"ip sla schedule {IPSLA_NUM} life forever start-time now",
                f"track {TRACK_NUM} ip sla {IPSLA_NUM} reachability",
                f"ip route 0.0.0.0 0.0.0.0 {ip_respaldo} 1 track {TRACK_NUM}",
                f"ip route 0.0.0.0 0.0.0.0 {ip_respaldo} 254",
            ])
        dep.extend(["end", "write memory"])
        rb.extend([
            "enable", "configure terminal",
            "no interface GigabitEthernet0/0", "no interface GigabitEthernet0/1",
            f"no ip route 0.0.0.0 0.0.0.0 {ip_wan_gw}",
            f"no ip sla {IPSLA_NUM}", f"no track {TRACK_NUM}",
            "end", "write memory",
        ])

    elif vendor == "Huawei":
        dep.extend(cmds_ssh_router(vendor, host))
        if ipv6:
            dep.append("ipv6")
        dep.extend([
            "interface GigabitEthernet0/0/0",
            f" ip address {ipv4} {SUBNET_MASK}", " description LAN",
        ])
        if ipv6:
            dep.append(f" ipv6 address {ipv6.replace('/64', ' 64')}")
        dep.extend([
            " quit",
