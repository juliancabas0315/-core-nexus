from netmiko import ConnectHandler
import json

# 1. BLOQUE DE DEFINICIÓN DE DISPOSITIVOS (Escalabilidad)
# Aquí configuras los parámetros de acceso. 
# El 'device_type' de Netmiko detecta si es cisco_ios, huawei, o fortinet.
dispositivos = [
    {
        "device_type": "cisco_ios",
        "host": "192.168.1.1",
        "username": "admin",
        "password": "password123",
        "secret": "enable_pass",
        "marca": "Cisco"
    },
    {
        "device_type": "fortinet",
        "host": "192.168.1.2",
        "username": "admin",
        "password": "password123",
        "marca": "Fortinet"
    }
]

# 2. BLOQUE DE GENERACIÓN DE COMANDOS (Adaptativo)
def generar_configuracion(piso, vlan_id, ip_base, marca):
    """
    Crea los comandos específicos según la marca del equipo.
    """
    if marca == "Cisco":
        return [
            f"vlan {vlan_id}",
            f"name PISO_{piso}",
            f"interface vlan {vlan_id}",
            f"ip address {ip_base} 255.255.255.0",
            "no shutdown"
        ]
    elif marca == "Huawei":
        return [
            f"vlan {vlan_id}",
            f"description PISO_{piso}",
            f"interface Vlanif{vlan_id}",
            f"ip address {ip_base} 255.255.255.0"
        ]
    elif marca == "Fortinet":
        return [
            f"config system interface",
            f"edit vlan{vlan_id}",
            f"set vdom root",
            f"set ip {ip_base} 255.255.255.0",
            f"set interface internal",
            f"set vlanid {vlan_id}",
            "next",
            "end"
        ]

# 3. BLOQUE DE EJECUCIÓN Y ROLLBACK
def aplicar_configuracion(num_pisos):
    for equipo in dispositivos:
        print(f"--- Conectando a {equipo['marca']} ({equipo['host']}) ---")
        try:
            net_connect = ConnectHandler(**{k: v for k, v in equipo.items() if k != 'marca'})
            net_connect.enable()
            
            # Crear respaldo antes de cambiar (Rollback manual simple)
            backup = net_connect.send_command("show running-config")
            with open(f"backup_{equipo['host']}.cfg", "w") as f:
                f.write(backup)

            for p in range(1, num_pisos + 1):
                vlan = p * 10
                ip = f"192.168.{vlan}.1"
                comandos = generar_configuracion(p, vlan, ip, equipo['marca'])
                
                print(f"Aplicando VLAN {vlan} para Piso {p}...")
                net_connect.send_config_set(comandos)
            
            net_connect.save_config()
            net_connect.disconnect()
            print("Configuración exitosa.")

        except Exception as e:
            print(f"ERROR en {equipo['host']}: {e}")
            print("Iniciando ROLLBACK: Por favor restaure el archivo de backup generado.")

# EJECUCIÓN: Usuario elige cantidad de pisos
cantidad = int(input("¿Cuántos pisos desea configurar? "))
aplicar_configuracion(cantidad)
