        if aplicar_stp_lacp:
            cmds.extend([
                "# ── HA 3: MSTP + LACP ──",
                f"stp mode {STP_MODE_HUAWEI}",
                "stp region-configuration",
                f" instance 1 vlan {vlan}",
                " active region-configuration",
                " quit",
                f"stp instance 1 priority {'4096' if es_activo else '8192'}",
                "! Edged-port equivalente a PortFast — solo en puertos de acceso:",
                "interface GigabitEthernet0/0/1",
                " stp edged-port enable",
                " quit",
                "stp bpdu-protection",
                "! EtherChannel LACP:",
                f"interface Eth-Trunk {LACP_CHANNEL_GROUP}",
                " mode lacp-static",
                " trunkport GigabitEthernet 0/0/3",
                " trunkport GigabitEthernet 0/0/4",
                " port link-type trunk",
                f" port trunk allow-pass vlan {vlan}",
                " quit",
            ])

    elif vendor == "Fortinet":
        if aplicar_gateway:
            cmds.extend([
                "# ── HA 1: VRRP — Redundancia de Gateway ──",
                "config system interface",
                f"    edit vlan{vlan}",
                "        config vrrp",
                f"            edit {HSRP_GRUPO}",
