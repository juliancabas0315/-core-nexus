# FUNCIONES — IPv6
# =============================================================================

def generar_ipv6(ipv4: str, modo: str) -> str | None:
    try:
        partes = ipv4.split('.')
        if len(partes) != 4:
            raise ValueError
        tercer = int(partes[2])
        cuarto = int(partes[3])
        if not (0 <= tercer <= 255 and 0 <= cuarto <= 255):
            raise ValueError
    except (ValueError, IndexError):
        return None

    h3 = format(tercer, '02X')
    h4 = format(cuarto, '02X')

    if modo.startswith("ULA"):
        return f"fd00:A8:{h3}::{h4}/64"
    elif modo.startswith("Link-Local"):
        return f"fe80::{h4}/64"
    else:
        return None


# =============================================================================
# FUNCIONES — PROTOCOLOS DE ENRUTAMIENTO IPv4
# =============================================================================

def cmds_routing_ipv4(vendor: str, protocolo: str, ipv4: str,
                       as_number: int, bgp_neighbor: str,
                       bgp_neighbor_as: int = 0,
                       vlan: int = 10) -> list:
    cmds = []
    red = ".".join(ipv4.split('.')[:3]) + ".0"

    if protocolo == "Ninguno":
        return []

    if vendor == "Cisco":
        if protocolo == "RIP v2":
            cmds.extend([
                f"ip prefix-list BLOCK_MGMT seq 5 deny {IP_BASE_1}.{IP_BASE_2}.{IP_ADMIN_OCTETO}.0/24",
                "ip prefix-list BLOCK_MGMT seq 10 permit 0.0.0.0/0 le 32",
                "router rip",
                " version 2",
                f" network {red}",
                " no auto-summary",
                " distribute-list prefix BLOCK_MGMT out",
                " exit",
            ])
        elif protocolo == "EIGRP":
            cmds.extend([
                f"ip prefix-list BLOCK_MGMT seq 5 deny {IP_BASE_1}.{IP_BASE_2}.{IP_ADMIN_OCTETO}.0/24",
                "ip prefix-list BLOCK_MGMT seq 10 permit 0.0.0.0/0 le 32",
                f"router eigrp {as_number}",
                f" network {red} 0.0.0.255",
                " no auto-summary",
                f" distribute-list prefix BLOCK_MGMT out",
                " exit",
            ])
        elif protocolo == "BGP":
            cmds.extend([
                f"router bgp {as_number}",
                f" neighbor {bgp_neighbor} remote-as {bgp_neighbor_as if bgp_neighbor_as else as_number}",
                f" network {red} mask {SUBNET_MASK}",
                " exit",
            ])

    elif vendor == "Huawei":
        if protocolo == "RIP v2":
            cmds.extend([
                f"ip ip-prefix BLOCK_MGMT index 5 deny {IP_BASE_1}.{IP_BASE_2}.{IP_ADMIN_OCTETO}.0 24",
                "ip ip-prefix BLOCK_MGMT index 10 permit 0.0.0.0 0 less-equal 32",
                "route-policy BLOCK_MGMT_POLICY permit node 10",
                " if-match ip-prefix BLOCK_MGMT",
                " quit",
                "rip 1",
                " version 2",
                f" network {red}",
                " undo summary",
                " filter-policy route-policy BLOCK_MGMT_POLICY export",
                " quit",
            ])
        elif protocolo == "EIGRP":
            cmds.extend([
                "# NOTA: EIGRP es protocolo propietario de Cisco.",
                "# En Huawei usar OSPF como alternativa equivalente:",
                "ospf 1",
                f" area 0",
                f" network {red} 0.0.0.255",
                " quit",
            ])
        elif protocolo == "BGP":
            cmds.extend([
                f"bgp {as_number}",
                f" peer {bgp_neighbor} as-number {bgp_neighbor_as if bgp_neighbor_as else as_number}",
                f" network {red}",
                " quit",
            ])

    elif vendor == "Fortinet":
        if protocolo == "RIP v2":
            cmds.extend([
                "config router rip",
                "    set version 2",
                "    config network",
                f"        edit {vlan}",
                f"            set prefix {red}/24",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "EIGRP":
            cmds.extend([
                "# NOTA: EIGRP no está disponible en FortiOS.",
                "# Alternativa recomendada: OSPF",
                "config router ospf",
                "    set router-id 1.1.1.1",
                "    config ospf-interface",
                f"        edit internal",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "BGP":
            cmds.extend([
                "config router bgp",
                f"    set as {as_number}",
                f"    set router-id {ipv4}",
                "    config neighbor",
                f"        edit {bgp_neighbor}",
                f"            set remote-as {bgp_neighbor_as if bgp_neighbor_as else as_number}",
                "        next",
                "    end",
                "    config network",
                f"        edit 1",
                f"            set prefix {red}/24",
                "        next",
                "    end",
                "end",
            ])

    return cmds


# =============================================================================
# FUNCIONES — PROTOCOLOS DE ENRUTAMIENTO IPv6
# =============================================================================

def cmds_routing_ipv6(vendor: str, protocolo: str, ipv6: str | None,
                       as_number: int, ospf_router_id: str,
                       vlan: int = 10) -> list:
    cmds = []
    if protocolo == "Ninguno" or ipv6 is None:
        return []

    addr = ipv6.split('/')[0]

    if vendor == "Cisco":
        if protocolo == "RIPng":
            cmds.extend([
                "ipv6 unicast-routing",
                "ipv6 router rip RIPNG_PROC",
                " exit",
                f"interface vlan {vlan}",
                " ipv6 rip RIPNG_PROC enable",
                " exit",
            ])
        elif protocolo == "OSPFv3":
            cmds.extend([
                "ipv6 unicast-routing",
                f"ipv6 router ospf 1",
                f" router-id {ospf_router_id}",
                " exit",
                f"interface vlan {vlan}",
                " ipv6 ospf 1 area 0",
                " exit",
            ])
        elif protocolo == "EIGRPv6":
            cmds.extend([
                "ipv6 unicast-routing",
                f"ipv6 router eigrp {as_number}",
                f" eigrp router-id {ospf_router_id}",
                " no shutdown",
                " exit",
                f"interface vlan {vlan}",
                f" ipv6 eigrp {as_number}",
                " exit",
            ])

    elif vendor == "Huawei":
        if protocolo == "RIPng":
            cmds.extend([
                "ripng 1",
                " quit",
                f"interface Vlanif{vlan}",
                " ripng 1 enable",
                " quit",
            ])
        elif protocolo == "OSPFv3":
            cmds.extend([
                f"ospfv3 1",
                f" router-id {ospf_router_id}",
                " quit",
                f"interface Vlanif{vlan}",
                " ospfv3 1 area 0",
                " quit",
            ])
        elif protocolo == "EIGRPv6":
            cmds.extend([
                "# NOTA: EIGRPv6 es propietario de Cisco. En Huawei usar OSPFv3:",
                f"ospfv3 1",
                f" router-id {ospf_router_id}",
                " quit",
            ])

    elif vendor == "Fortinet":
        if protocolo == "RIPng":
            cmds.extend([
                "config router ripng",
                "    config redistribute",
                "        edit connected",
                "            set status enable",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "OSPFv3":
            cmds.extend([
                "config router ospf6",
                f"    set router-id {ospf_router_id}",
                "    config area",
                "        edit 0.0.0.0",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "EIGRPv6":
            cmds.extend([
                "# NOTA: EIGRPv6 no está disponible en FortiOS.",
                "config router ospf6",
                f"    set router-id {ospf_router_id}",
                "end",
            ])

    return cmds


# =============================================================================
# FUNCIONES — ALTA DISPONIBILIDAD (HA)
# =============================================================================

def cmds_alta_disponibilidad(vendor: str, vlan: int, ipv4: str,
                              ipv6: str | None, modo_ha: str,
                              ip_respaldo: str, es_activo: bool) -> list:
    cmds = []
    red_prefix = ".".join(ipv4.split(".")[:3])
    ip_virtual  = f"{red_prefix}.254"
    prioridad   = HSRP_PRIORIDAD_ACTIVO if es_activo else HSRP_PRIORIDAD_STANDBY

    aplicar_gateway  = modo_ha in ("HSRP/VRRP", "Completo")
    aplicar_ipsla    = modo_ha in ("IP SLA + Ruta Flotante", "Completo")
    aplicar_stp_lacp = modo_ha in ("STP Rápido + EtherChannel", "Completo")

    if vendor == "Cisco":
        if aplicar_gateway:
            cmds.extend([
                "# ── HA 1: HSRP — Redundancia de Gateway ──",
                f"interface vlan {vlan}",
                f" standby {HSRP_GRUPO} ip {ip_virtual}",
                f" standby {HSRP_GRUPO} priority {prioridad}",
                f" standby {HSRP_GRUPO} preempt",
                f" standby {HSRP_GRUPO} timers {HSRP_HELLO} {HSRP_HOLD}",
                f" standby {HSRP_GRUPO} track 1 decrement 20",
                " exit",
            ])
            if ipv6:
                cmds.extend([
                    f"interface vlan {vlan}",
                    f" standby version 2",
                    f" standby {HSRP_GRUPO} ipv6 autoconfig",
                    " exit",
                ])
        if aplicar_ipsla:
            cmds.extend([
                "# ── HA 2: IP SLA + Track — Rutas de Respaldo ──",
                f"ip sla {IPSLA_NUM}",
                f" icmp-echo {ip_respaldo} source-ip {ipv4}",
                " frequency 5",
                " exit",
                f"ip sla schedule {IPSLA_NUM} life forever start-time now",
                f"track {TRACK_NUM} ip sla {IPSLA_NUM} reachability",
                f"ip route 0.0.0.0 0.0.0.0 {ip_respaldo} 1 track {TRACK_NUM}",
                f"ip route 0.0.0.0 0.0.0.0 {ip_respaldo} 254",
            ])
        if aplicar_stp_lacp:
            cmds.extend([
                "# ── HA 3: Rapid PVST+ + EtherChannel LACP ──",
                f"spanning-tree mode {STP_MODE_CISCO}",
                f"spanning-tree vlan {vlan} priority {'4096' if es_activo else '8192'}",
                "interface range GigabitEthernet0/1 - 2",
                " spanning-tree portfast",
                " spanning-tree bpduguard enable",
                " exit",
                f"interface range GigabitEthernet0/3 - 4",
                f" channel-group {LACP_CHANNEL_GROUP} mode active",
                " exit",
                f"interface port-channel {LACP_CHANNEL_GROUP}",
                f" switchport mode trunk",
                f" switchport trunk allowed vlan {vlan}",
                " exit",
                f"bfd interval {BFD_INTERVAL} min_rx {BFD_INTERVAL} multiplier {BFD_MULTIPLIER}",
            ])

    elif vendor == "Huawei":
        if aplicar_gateway:
            cmds.extend([
                "# ── HA 1: VRRP — Redundancia de Gateway ──",
                f"interface Vlanif{vlan}",
                f" vrrp vrid {HSRP_GRUPO} virtual-ip {ip_virtual}",
                f" vrrp vrid {HSRP_GRUPO} priority {prioridad}",
                f" vrrp vrid {HSRP_GRUPO} preempt-mode timer delay 0",
                f" vrrp vrid {HSRP_GRUPO} timer advertise {HSRP_HELLO * 1000}",
                " quit",
            ])
            if ipv6:
                cmds.extend([
                    f"interface Vlanif{vlan}",
                    f" vrrp6 vrid {HSRP_GRUPO} virtual-ip fe80::FFFE link-local",
                    f" vrrp6 vrid {HSRP_GRUPO} priority {prioridad}",
                    " quit",
                ])
        if aplicar_ipsla:
            cmds.extend([
                "# ── HA 2: NQA + Track — Rutas de Respaldo ──",
                f"nqa test-instance admin SLA_{IPSLA_NUM}",
                "  test-type icmp",
                f"  destination-address ipv4 {ip_respaldo}",
                f"  source-address ipv4 {ipv4}",
                "  frequency 5",
                "  probe-count 3",
                "  start now",
                " quit",
                f"track {TRACK_NUM} nqa admin SLA_{IPSLA_NUM} probe-fail",
                f"ip route-static 0.0.0.0 0 {ip_respaldo} preference 1 track {TRACK_NUM}",
                f"ip route-static 0.0.0.0 0 {ip_respaldo} preference 254",
            ])
        if aplicar_stp_lacp:
            cmds.extend([
                "# ── HA 3: MSTP + LACP ──",
                f"stp mode {STP_MODE_HUAWEI}",
                "stp region-configuration",
                f" instance 1 vlan {vlan}",
                " active region-configuration",
                " quit",
                f"stp instance 1 priority {'4096' if es_activo else '8192'}",
                "interface GigabitEthernet0/0/1",
                " stp edged-port enable",
                " stp bpdu-protection",
                " quit",
                f"interface Eth-Trunk {LACP_CHANNEL_GROUP}",
                " mode lacp-static",
                f" trunkport GigabitEthernet 0/0/3",
                f" trunkport GigabitEthernet 0/0/4",
                f" port link-type trunk",
                f" port trunk allow-pass vlan {vlan}",
                " quit",
                f"bfd",
                " quit",
                f"interface Vlanif{vlan}",
                f" bfd min-tx-interval {BFD_INTERVAL} min-rx-interval {BFD_INTERVAL} detect-multiplier {BFD_MULTIPLIER}",
                " quit",
            ])

    elif vendor == "Fortinet":
        if aplicar_gateway:
            cmds.extend([
                "# ── HA 1: VRRP — Redundancia de Gateway ──",
                "config system interface",
                f"    edit vlan{vlan}",
                "        config vrrp",
                f"            edit {HSRP_GRUPO}",
                f"                set vrip {ip_virtual}",
                f"                set priority {prioridad}",
                "                set adv-interval 1",
                "                set preempt enable",
                "            next",
                "        end",
                "    next",
                "end",
            ])
        if aplicar_ipsla:
            cmds.extend([
                "# ── HA 2: Link Monitor + Ruta Flotante ──",
                "config system link-monitor",
                f"    edit MONITOR_VL{vlan}",
                f"        set srcintf internal",
                f"        set server {ip_respaldo}",
                "        set interval 5",
                "        set failtime 3",
                "        set update-static-route enable",
                "    next",
                "end",
                "config router static",
                f"    edit {vlan}0",
                f"        set gateway {ip_respaldo}",
                "        set device internal",
                "        set distance 10",
                "    next",
                "end",
                "config router static",
                f"    edit {vlan}1",
                f"        set gateway {ip_respaldo}",
                "        set device wan1",
                "        set distance 254",
                "    next",
                "end",
            ])
        if aplicar_stp_lacp:
            cmds.extend([
                "# ── HA 3: FortiGate HA (FGCP) + LACP ──",
                "config system ha",
                "    set mode a-p",
                "    set group-name CORE_NEXUS_HA",
                "    set password HA_SECRET_CHANGE_ME",
                f"    set priority {'200' if es_activo else '100'}",
                "    set session-pickup enable",
                "    set override enable",
                "    set hbdev port3 50 port4 50",
                "end",
                "config system interface",
                f"    edit lacp{LACP_CHANNEL_GROUP}",
                "        set type aggregate",
                f"        set member port3 port4",
                "        set lacp-mode active",
                "    next",
                "end",
            ])

    return cmds


