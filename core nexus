# =============================================================================
# FUNCIONES — FORMATEO / RESET DE EQUIPOS
# =============================================================================

def generar_formato_equipo(vendor: str, host: str, nivel: str,
                            vlan_admin: int, ip_admin: str,
                            vlan_datos_list: list) -> list:
    cmds = []
    cmds.extend([
        f"! {'='*60}",
        f"! CORE-NEXUS — FORMATEO PREVIO AL DEPLOY",
        f"! Equipo  : {host}",
        f"! Vendor  : {vendor}",
        f"! Nivel   : {nivel}",
        f"! ADVERTENCIA: Ejecutar ANTES del script de deploy.",
        f"! {'='*60}",
    ])

    if vendor == "Cisco":
        if nivel == "Limpieza Selectiva":
            cmds.extend(["enable", "configure terminal", ""])
            for v in vlan_datos_list:
                cmds.append(f"no ip dhcp pool POOL_{v}")
            for v in vlan_datos_list:
                cmds.extend([f"no interface vlan {v}", f"no vlan {v}"])
            cmds.extend([
                "no router rip", "no router eigrp 1", "no router ospf 1",
                "no ipv6 router rip RIPNG_PROC", "no ipv6 router ospf 1",
                "no ip prefix-list BLOCK_MGMT",
            ])
            for v in vlan_datos_list:
                cmds.extend([f"interface vlan {v}", f" no standby {HSRP_GRUPO}", " exit"])
            cmds.extend([
                f"no ip sla {IPSLA_NUM}", f"no track {TRACK_NUM}",
                f"no interface port-channel {LACP_CHANNEL_GROUP}",
                "no spanning-tree vlan 1-4094 priority",
                "no ip access-list extended INSIDE_OUT",
                "end", "write memory",
            ])
        elif nivel == "Reset Completo":
            cmds.extend(["enable", "configure terminal", ""])
            for v in vlan_datos_list:
                cmds.extend([f"no interface vlan {v}", f"no vlan {v}"])
            cmds.extend([
                f"no interface vlan {vlan_admin}", f"no vlan {vlan_admin}",
                "no ip route 0.0.0.0 0.0.0.0",
                "no router rip", "no router eigrp 1", "no router ospf 1", "no router bgp 65001",
                "no ip dhcp pool", "no ip dhcp excluded-address",
                f"no ip sla {IPSLA_NUM}", f"no track {TRACK_NUM}",
                f"no interface port-channel {LACP_CHANNEL_GROUP}",
                "no ip prefix-list BLOCK_MGMT",
                f"username {SSH_USER} privilege 15 secret {SSH_PASS}",
                f"interface vlan {vlan_admin}",
                f" ip address {ip_admin} {SUBNET_MASK}", " no shutdown", " exit",
                "end", "write memory",
            ])
        elif nivel == "Reset de Fábrica":
            cmds.extend([
                "enable", "write erase", "delete flash:vlan.dat", "reload",
            ])

    elif vendor == "Huawei":
        if nivel == "Limpieza Selectiva":
            cmds.extend(["system-view", ""])
            for v in vlan_datos_list:
                cmds.extend([f"undo interface Vlanif{v}", f"undo vlan {v}"])
            cmds.extend([
                "undo rip 1", "undo ospf 1", "undo ospfv3 1", "undo ripng 1",
                "undo ip ip-prefix BLOCK_MGMT",
            ])
            for v in vlan_datos_list:
                cmds.extend([f"interface Vlanif{v}", f" undo vrrp vrid {HSRP_GRUPO}", " quit"])
            cmds.extend([
                f"undo nqa test-instance admin SLA_{IPSLA_NUM}",
                f"undo track {TRACK_NUM}",
                f"undo interface Eth-Trunk {LACP_CHANNEL_GROUP}",
                "return", "save", "y",
            ])
        elif nivel == "Reset Completo":
            cmds.extend(["system-view", ""])
            for v in vlan_datos_list:
                cmds.extend([f"undo interface Vlanif{v}", f"undo vlan {v}"])
            cmds.extend([
                f"undo interface Vlanif{vlan_admin}", f"undo vlan {vlan_admin}",
                "undo rip 1", "undo ospf 1", "undo bgp all", "undo ip route-static 0.0.0.0 0",
                "undo dhcp enable",
                f"vlan {vlan_admin}", " quit",
                f"interface Vlanif{vlan_admin}",
                f" ip address {ip_admin} {SUBNET_MASK}", " quit",
                "stelnet server enable",
                "aaa",
                f" local-user {SSH_USER} password irreversible-cipher {SSH_PASS}",
                f" local-user {SSH_USER} service-type ssh",
                f" local-user {SSH_USER} privilege level 15",
                " quit",
                "return", "save", "y",
            ])
        elif nivel == "Reset de Fábrica":
            cmds.extend([
                "system-view", "undo sysname", "return",
                "reset saved-configuration", "reboot fast",
            ])

    elif vendor == "Fortinet":
        if nivel == "Limpieza Selectiva":
            cmds.extend(["config system interface"])
            for v in vlan_datos_list:
                cmds.append(f"    delete vlan{v}")
            cmds.extend(["end", "config router static"])
            for v in vlan_datos_list:
                cmds.extend([f"    delete {v}0", f"    delete {v}1"])
            cmds.append("end")
        elif nivel == "Reset Completo":
            cmds.extend(["config system interface"])
            for v in vlan_datos_list:
                cmds.append(f"    delete vlan{v}")
            cmds.extend([
                f"    edit vlan{vlan_admin}",
                f"        set ip {ip_admin} {SUBNET_MASK}",
                "        set allowaccess ssh", "    next", "end",
                "config firewall policy", "    delete 1", "end",
                "config router static", "end",
                "config system ha", "    set mode standalone", "end",
            ])
        elif nivel == "Reset de Fábrica":
            cmds.extend(["execute factoryreset"])

    return cmds


