import streamlit as st
import pandas as pd
import re
import io
from netmiko import ConnectHandler # Librería para despliegue directo

# --- CONFIGURACIÓN DE PÁGINA ---
st.set_page_config(
    page_title="NetEng Pro v7 - Auto-Deploy & Fiber Infrastructure",
    layout="wide",
    initial_sidebar_state="expanded",
    page_icon="📡"
)

# --- MÓDULO DE LÓGICA TÉCNICA ---

def conv_ipv4_to_ipv6(ipv4):
    """Genera IPv6 Mapped estandarizada."""
    try:
        parts = [int(x) for x in ipv4.split('.')]
        return f"2001:db8:1:{parts[2]}::{parts[3]}/64"
    except: return "N/A"

def generar_config_core(vendor, datos, global_cfg):
    """Genera comandos con modos de configuración completos."""
    dep, rb = [], []
    
    if vendor == "Cisco":
        dep.extend(["enable", "configure terminal", f"hostname {global_cfg['host']}"])
        rb.extend(["enable", "configure terminal"])
        for _, r in datos.iterrows():
            dep.extend([f"vlan {r['VLAN']}", f" name {r['Nombre']}", " exit",
                        f"interface vlan {r['VLAN']}", f" ip address {r['IPv4']} 255.255.255.0",
                        f" ipv6 address {r['IPv6'].split('/')[0]}/64", " no shut", " exit"])
            rb.extend([f"no interface vlan {r['VLAN']}", f"no vlan {r['VLAN']}"])
        dep.extend(["end", "write memory"])

    elif vendor == "Huawei":
        dep.extend(["system-view", f"sysname {global_cfg['host']}", "ipv6"])
        rb.extend(["system-view"])
        for _, r in datos.iterrows():
            dep.extend([f"vlan {r['VLAN']}", f" description {r['Nombre']}", " quit",
                        f"interface Vlanif{r['VLAN']}", f" ip address {r['IPv4']} 255.255.255.0",
                        f" ipv6 address {r['IPv6'].replace('/64', ' 64')}", " quit"])
            rb.extend([f"undo interface Vlanif{r['VLAN']}", f"undo vlan {r['VLAN']}"])
        dep.extend(["return", "save", "y"])

    return dep, rb

# --- INTERFAZ DE USUARIO ---
st.title("📡 NetEng Pro v7.0 - Despliegue & AP Config")

with st.sidebar:
    st.header("🛠️ Configuración Global")
    proyecto = st.text_input("Proyecto", "Fibertec_Sopo_01")
    vendor = st.selectbox("Fabricante Core", ["Cisco", "Huawei", "Fortinet"])
    ip_red = st.text_input("Red Base IPv4", "192.168.10.0")
    
    st.divider()
    st.subheader("🚀 Credenciales de Despliegue")
    target_ip = st.text_input("IP Destino (SSH)", placeholder="10.0.0.1")
    ssh_user = st.text_input("Usuario", "admin")
    ssh_pass = st.text_input("Password", type="password")

if ip_red:
    c1, c2, c3 = st.columns(3)
    num_seg = c1.number_input("N° Segmentos", 1, 10, 2)
    host_name = c2.text_input("Hostname", "CORE-SW-01")
    vlan_init = c3.number_input("VLAN Inicial", 100, 4000, 100)

    # Tabla de Direccionamiento
    octs = ip_red.split('.')
    lista_datos = []
    for i in range(num_seg):
        ipv4 = f"{octs[0]}.{octs[1]}.{int(octs[2])+i}.1"
        lista_datos.append({
            "Piso": f"Nivel {i+1}",
            "Nombre": f"VLAN_PISO_{i+1}",
            "VLAN": vlan_init + (i*10),
            "IPv4": ipv4,
            "IPv6": conv_ipv4_to_ipv6(ipv4)
        })
    df = pd.DataFrame(lista_datos)
    st.table(df)

    # Generar Scripts
    dep_cmds, rb_cmds = generar_config_core(vendor, df, {"host": host_name})

    # TABS
    t1, t2, t3, t4 = st.tabs(["📄 Scripts Core", "⏪ Rollback", "📶 TP-LINK A200 (Manual)", "⚡ DESPLIEGUE DIRECTO"])

    with t1:
        st.code("\n".join(dep_cmds), language="bash")
    
    with t2:
        st.code("\n".join(rb_cmds), language="bash")

    with t3:
        st.subheader("🛠️ Configuración Access Point TP-Link Archer A200")
        
        st.markdown(f"""
        Siga estos pasos para integrar el AP a la infraestructura de **Fibertec**:

        1. **Acceso Inicial:** Conecte su PC al puerto LAN 1. Ingrese a `http://192.168.0.1`.
        2. **Modo de Operación:** Vaya a `Advanced > Operation Mode` y seleccione **Access Point Mode**. Esto desactivará las funciones de router para evitar conflictos de NAT.
        3. **Configuración LAN Local:**
            - Ingrese a `Network > LAN`.
            - **IP Address:** `{df.iloc[0]['IPv4']}` (o una IP libre en el segmento).
            - **Subnet Mask:** `255.255.255.0`.
        4. **Red Inalámbrica (SSID):**
            - Ingrese a `Wireless > Wireless Settings`.
            - **SSID (2.4GHz/5GHz):** Defina el nombre de red.
            - **Security:** Seleccione **WPA2-PSK (AES)** para máxima compatibilidad.
        5. **DHCP & VLANs:**
            - Si el Core maneja el DHCP, desactive el DHCP en el TP-Link (`Network > DHCP Server > Disable`).
            - Si requiere segmentación, configure el **IPTV/VLAN ID** en `Advanced > Network > IPTV` para taguear el tráfico hacia el switch.
        """)

    with t4:
        st.subheader("🚀 Push Configuration (Auto-Deploy)")
        if st.button("🔥 EJECUTAR EN EQUIPO REAL"):
            try:
                device_types = {"Cisco": "cisco_ios", "Huawei": "huawei", "Fortinet": "fortinet"}
                dispositivo = {
                    'device_type': device_types[vendor],
                    'host': target_ip,
                    'username': ssh_user,
                    'password': ssh_pass,
                    'secret': ssh_pass
                }
                with st.spinner("Estableciendo conexión SSH..."):
                    net_connect = ConnectHandler(**dispositivo)
                    if vendor == "Cisco": net_connect.enable()
                    
                    st.info("Enviando bloque de comandos...")
                    output = net_connect.send_config_set(dep_cmds)
                    st.success("Despliegue completado con éxito.")
                    st.text_area("Log de Consola:", output, height=250)
                    net_connect.disconnect()
            except Exception as e:
                st.error(f"Falla en el despliegue: {e}")

    # Exportación
    buffer = io.StringIO()
    buffer.write(f"PROYECTO: {proyecto}\n" + "="*30 + "\n")
    buffer.write(">> CONFIGURACIÓN CORE:\n" + "\n".join(dep_cmds))
    st.download_button("💾 Guardar Reporte TXT", buffer.getvalue(), file_name=f"{proyecto}_Final.txt")

else:
    st.info("Complete el segmento base de red para generar la arquitectura.")
