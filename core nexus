    font-size: 11px;
    color: var(--text-muted);
    margin-top: 3px;
    letter-spacing: 1px;
}
.cn-page-header .cn-version {
    margin-left: auto;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 4px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--cyan);
    letter-spacing: 1px;
    white-space: nowrap;
}

/* Session status pill */
.cn-session-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 20px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
}
.cn-session-pill.active {
    background: rgba(16,185,129,0.12);
    border: 1px solid rgba(16,185,129,0.3);
    color: var(--green);
}
.cn-session-pill.inactive {
    background: rgba(74,90,114,0.2);
    border: 1px solid var(--border);
    color: var(--text-muted);
}
.cn-session-pill .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
}

