# =============================================================================
# FUNCIONES — IPv6
# =============================================================================
 
def generar_ipv6(ipv4: str, modo: str) -> str | None:
    """
    Convierte una IPv4 en su equivalente IPv6 según el modo elegido.
 
    ULA:        fd00:a8:<tercer_octeto_hex>::<cuarto_octeto_hex>/64
    Link-Local: fe80::<cuarto_octeto_hex>/64
    Sin IPv6:   None
    """
    p      = ipv4.split('.')
    tercer = int(p[2])
    cuarto = int(p[3])
 
    if modo.startswith("ULA"):
        return f"fd00:a8:{tercer:x}::{cuarto:x}/64"
    elif modo.startswith("Link-Local"):
        return f"fe80::{cuarto:x}/64"
    else:
        return None
 
 
# =============================================================================
# FUNCIONES — PROTOCOLOS DE ENRUTAMIENTO IPv4
# =============================================================================
 
def cmds_routing_ipv4(vendor: str, protocolo: str, ipv4: str,
                       as_number: int, bgp_neighbor: str) -> list:
    """
    Genera los comandos de enrutamiento IPv4 para el vendor y protocolo elegidos.
 
    Args:
        vendor:       "Cisco" | "Huawei" | "Fortinet"
        protocolo:    "RIP v2" | "EIGRP" | "BGP" | "Ninguno"
        ipv4:         IP del gateway del primer segmento (para anunciar la red)
        as_number:    Número de AS (para EIGRP y BGP)
        bgp_neighbor: IP del vecino BGP
 
    Returns:
        Lista de comandos CLI listos para agregar al script
    """
    cmds = []
 
    # Extraer la red /24 a partir de la IP del gateway
    # Ejemplo: 192.168.1.1 → 192.168.1.0
    red = ".".join(ipv4.split('.')[:3]) + ".0"
 
    if protocolo == "Ninguno":
        return []
 
    # ── CISCO ──────────────────────────────────────────────────────────────
    if vendor == "Cisco":
        if protocolo == "RIP v2":
            cmds.extend([
                "router rip",
                " version 2",                   # RIP versión 2 (soporta VLSM)
                f" network {red}",              # Anunciar esta red por RIP
                " no auto-summary",             # Deshabilitar resumen automático
                " exit",
            ])
        elif protocolo == "EIGRP":
            cmds.extend([
                f"router eigrp {as_number}",    # Iniciar EIGRP con el AS configurado
                f" network {red} 0.0.0.255",    # Red + wildcard mask (/24 → 0.0.0.255)
                " no auto-summary",
                " exit",
            ])
        elif protocolo == "BGP":
            cmds.extend([
                f"router bgp {as_number}",      # Iniciar BGP con el AS local
                f" neighbor {bgp_neighbor} remote-as {as_number}",  # Vecino iBGP
                f" network {red} mask {SUBNET_MASK}",               # Red a anunciar
                " exit",
            ])
 
    # ── HUAWEI ─────────────────────────────────────────────────────────────
    elif vendor == "Huawei":
        if protocolo == "RIP v2":
            cmds.extend([
                "rip 1",                        # Proceso RIP número 1
                " version 2",
                f" network {red}",
                " undo summary",                # Huawei usa "undo" en lugar de "no"
                " quit",
            ])
        elif protocolo == "EIGRP":
            # Huawei no soporta EIGRP nativo (es propietario de Cisco).
            # Se usa como comentario informativo en el script generado.
            cmds.extend([
                "# NOTA: EIGRP es protocolo propietario de Cisco.",
                "# En Huawei usar OSPF como alternativa equivalente:",
                "ospf 1",
                f" area 0",
                f" network {red} 0.0.0.255",
                " quit",
            ])
        elif protocolo == "BGP":
            cmds.extend([
                f"bgp {as_number}",
                f" peer {bgp_neighbor} as-number {as_number}",
                f" network {red}",
                " quit",
            ])
 
    # ── FORTINET ───────────────────────────────────────────────────────────
    elif vendor == "Fortinet":
        if protocolo == "RIP v2":
            cmds.extend([
                "config router rip",
                "    set version 2",
                "    config network",
                f"        edit 1",
                f"            set prefix {red}/24",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "EIGRP":
            cmds.extend([
                "# NOTA: EIGRP no está disponible en FortiOS.",
                "# Alternativa recomendada: OSPF",
                "config router ospf",
                "    set router-id 1.1.1.1",
                "    config ospf-interface",
                f"        edit internal",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "BGP":
            cmds.extend([
                "config router bgp",
                f"    set as {as_number}",
                f"    set router-id {ipv4}",
                "    config neighbor",
                f"        edit {bgp_neighbor}",
                f"            set remote-as {as_number}",
                "        next",
                "    end",
                "    config network",
                f"        edit 1",
                f"            set prefix {red}/24",
                "        next",
                "    end",
                "end",
            ])
 
    return cmds
 
 
# =============================================================================
# FUNCIONES — PROTOCOLOS DE ENRUTAMIENTO IPv6
# =============================================================================
 
def cmds_routing_ipv6(vendor: str, protocolo: str, ipv6: str | None,
                       as_number: int, ospf_router_id: str) -> list:
    """
    Genera los comandos de enrutamiento IPv6.
 
    Args:
        vendor:        "Cisco" | "Huawei" | "Fortinet"
        protocolo:     "RIPng" | "OSPFv3" | "EIGRPv6" | "Ninguno"
        ipv6:          Dirección IPv6 del gateway (puede ser None)
        as_number:     Número de AS para EIGRPv6
        ospf_router_id: Router-ID para OSPFv3 (debe ser IPv4 aunque sea OSPFv3)
 
    Returns:
        Lista de comandos CLI
    """
    cmds = []
 
    # Si no hay IPv6 configurado, no tiene sentido generar comandos de routing IPv6
    if protocolo == "Ninguno" or ipv6 is None:
        return []
 
    # Extraer solo la dirección sin el prefijo "/64"
    addr = ipv6.split('/')[0]
 
    # ── CISCO ──────────────────────────────────────────────────────────────
    if vendor == "Cisco":
        if protocolo == "RIPng":
            cmds.extend([
                "ipv6 unicast-routing",         # Habilitar enrutamiento IPv6 globalmente
                "ipv6 router rip RIPNG_PROC",   # Crear proceso RIPng con nombre
                " exit",
                # La activación por interfaz se hace en la sección de interfaces
                "# NOTA: Activar RIPng en cada interfaz con:",
                "#   interface vlan X → ipv6 rip RIPNG_PROC enable",
            ])
        elif protocolo == "OSPFv3":
            cmds.extend([
                "ipv6 unicast-routing",
                f"ipv6 router ospf 1",
                f" router-id {ospf_router_id}",  # Router-ID en formato IPv4
                " exit",
                "# NOTA: Activar OSPFv3 en cada interfaz con:",
                "#   interface vlan X → ipv6 ospf 1 area 0",
            ])
        elif protocolo == "EIGRPv6":
            cmds.extend([
                "ipv6 unicast-routing",
                f"ipv6 router eigrp {as_number}",
                f" eigrp router-id {ospf_router_id}",
                " no shutdown",
                " exit",
                "# NOTA: Activar EIGRPv6 en cada interfaz con:",
                "#   interface vlan X → ipv6 eigrp {as_number}",
            ])
 
    # ── HUAWEI ─────────────────────────────────────────────────────────────
    elif vendor == "Huawei":
        if protocolo == "RIPng":
            cmds.extend([
                "ripng 1",                      # Proceso RIPng número 1
                " quit",
                "# NOTA: Activar en interfaz con:",
                "#   interface Vlanif X → ripng 1 enable",
            ])
        elif protocolo == "OSPFv3":
            cmds.extend([
                f"ospfv3 1",
                f" router-id {ospf_router_id}",
                " quit",
                "# NOTA: Activar en interfaz con:",
                "#   interface Vlanif X → ospfv3 1 area 0",
            ])
        elif protocolo == "EIGRPv6":
            cmds.extend([
                "# NOTA: EIGRPv6 es propietario de Cisco. En Huawei usar OSPFv3:",
                f"ospfv3 1",
                f" router-id {ospf_router_id}",
                " quit",
            ])
 
    # ── FORTINET ───────────────────────────────────────────────────────────
    elif vendor == "Fortinet":
        if protocolo == "RIPng":
            cmds.extend([
                "config router ripng",
                "    config aggregate-address",
                "    end",
                "    config redistribute",
                "        edit connected",
                "            set status enable",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "OSPFv3":
            cmds.extend([
                "config router ospf6",
                f"    set router-id {ospf_router_id}",
                "    config area",
                "        edit 0.0.0.0",
                "        next",
                "    end",
                "end",
            ])
        elif protocolo == "EIGRPv6":
            cmds.extend([
                "# NOTA: EIGRPv6 no está disponible en FortiOS.",
                "# Alternativa recomendada: OSPFv3",
                "config router ospf6",
                f"    set router-id {ospf_router_id}",
                "end",
            ])
 
    return cmds
 
 
# =============================================================================
# FUNCIONES — VLAN ADMINISTRATIVA + SSH
# =============================================================================
 
def cmds_vlan_admin(vendor: str, vlan_admin: int, ip_admin: str,
                     host: str) -> list:
    """
    Genera la configuración de la VLAN administrativa con acceso SSH.
 
    Esta VLAN es exclusiva para gestión del equipo (no transporta tráfico
    de usuarios). Solo el administrador puede conectarse por SSH al equipo
    a través de la IP asignada a esta VLAN.
 
    Args:
        vendor:    "Cisco" | "Huawei" | "Fortinet"
        vlan_admin: ID de la VLAN administrativa (la primera VLAN del rango)
        ip_admin:  IP del gateway de gestión (192.168.X.1)
        host:      Hostname del equipo
 
    Returns:
        Lista de comandos CLI
    """
    cmds = []
 
    # ── CISCO ──────────────────────────────────────────────────────────────
    if vendor == "Cisco":
        cmds.extend([
            "# ── VLAN ADMINISTRATIVA + SSH ──",
            f"vlan {vlan_admin}",
            " name VLAN_ADMIN_MGMT",            # Nombre descriptivo
            " exit",
            f"interface vlan {vlan_admin}",
            f" ip address {ip_admin} {SUBNET_MASK}",
            " no shutdown",
            " exit",
 
            # Generar claves RSA para SSH (mínimo 1024 bits para SSH v2)
            "crypto key generate rsa modulus 2048",
 
            # Forzar SSH versión 2 (más seguro que v1)
            "ip ssh version 2",
            "ip ssh time-out 60",               # Timeout de sesión: 60 segundos
            "ip ssh authentication-retries 3",   # Máximo 3 intentos de login
 
            # Crear usuario local con privilegio máximo (nivel 15)
            f"username {SSH_USER} privilege 15 secret {SSH_PASS}",
 
            # Configurar las líneas VTY (terminales virtuales = sesiones SSH/Telnet)
            # "line vty 0 4" = hasta 5 sesiones simultáneas (0,1,2,3,4)
            "line vty 0 4",
            " transport input ssh",             # Solo permitir SSH, bloquear Telnet
            " login local",                     # Autenticar con usuarios locales
            " exec-timeout 10 0",               # Cerrar sesión inactiva tras 10 min
            " exit",
        ])
 
    # ── HUAWEI ─────────────────────────────────────────────────────────────
    elif vendor == "Huawei":
        cmds.extend([
            "# ── VLAN ADMINISTRATIVA + SSH ──",
            f"vlan {vlan_admin}",
            f" description VLAN_ADMIN_MGMT",
            " quit",
            f"interface Vlanif{vlan_admin}",
            f" ip address {ip_admin} {SUBNET_MASK}",
            " quit",
 
            # Generar par de claves RSA para SSH
            "rsa local-key-pair create",
            "2048",                             # Tamaño de clave en bits
 
            # Habilitar el servicio SSH en el sistema
            "stelnet server enable",
 
            # Crear usuario con nivel de acceso 15 (administrador)
            f"aaa",
            f" local-user {SSH_USER} password irreversible-cipher {SSH_PASS}",
            f" local-user {SSH_USER} service-type ssh",
            f" local-user {SSH_USER} privilege level 15",
            " quit",
 
            # Configurar la interfaz de usuario para SSH
            "user-interface vty 0 4",
            " authentication-mode aaa",         # Usar autenticación AAA (usuarios locales)
            " protocol inbound ssh",            # Solo SSH, no Telnet
            " idle-timeout 10 0",               # Timeout de inactividad: 10 minutos
            " quit",
        ])
 
    # ── FORTINET ───────────────────────────────────────────────────────────
    elif vendor == "Fortinet":
        cmds.extend([
            "# ── VLAN ADMINISTRATIVA + SSH ──",
            "config system interface",
            f"    edit vlan{vlan_admin}",
            "        set vdom root",
            f"        set ip {ip_admin} {SUBNET_MASK}",
            f"        set vlanid {vlan_admin}",
            "        set interface internal",
            "        set allowaccess ssh",      # Permitir SSH en esta interfaz
            "    next",
            "end",
 
            # Crear administrador con acceso SSH
            "config system admin",
            f"    edit {SSH_USER}",
            f"        set password {SSH_PASS}",
            "        set accprofile super_admin",  # Perfil de administrador completo
            "        set vdom root",
            "    next",
            "end",
 
            # Asegurar que SSH esté habilitado globalmente
            "config system global",
            "    set admin-ssh-port 22",
            "end",
        ])
 
    return cmds
 
 
