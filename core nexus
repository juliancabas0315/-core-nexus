# FUNCIONES — CONFIGURACIÓN DE FIREWALL
# =============================================================================
 
def generar_config_firewall(vendor_fw: str, host_fw: str,
                             ip_wan: str, ip_lan: str,
                             ipv6: str | None,
                             proto_v4: str, proto_v6: str,
                             as_number: int, bgp_neighbor: str,
                             ospf_router_id: str) -> tuple:
    """
    Genera la configuración de firewall para Cisco ASA, Huawei USG o Fortinet FGT.
 
    Incluye: hostname, interfaces WAN/LAN, NAT básico, política de acceso,
             SSH de gestión y protocolos de enrutamiento.
 
    Args:
        vendor_fw:     "Cisco ASA" | "Huawei USG" | "Fortinet FGT"
        host_fw:       Hostname del firewall
        ip_wan:        IP de la interfaz WAN (hacia Internet/proveedor)
        ip_lan:        IP de la interfaz LAN (hacia la red interna)
        ipv6:          Dirección IPv6 para la interfaz LAN (o None)
        proto_v4:      Protocolo de enrutamiento IPv4
        proto_v6:      Protocolo de enrutamiento IPv6
        as_number:     AS para EIGRP/BGP
        bgp_neighbor:  IP vecino BGP
        ospf_router_id: Router-ID OSPFv3
 
    Returns:
        (deploy, rollback): tupla de listas de comandos
    """
    dep, rb = [], []
 
    # ── CISCO ASA ──────────────────────────────────────────────────────────
    if vendor_fw == "Cisco ASA":
        dep.extend([
            "enable",
            "configure terminal",
            f"hostname {host_fw}",
 
            "# ── Interfaces ──",
            # Interfaz WAN (outside) — nivel de seguridad 0 = menos confiable
            "interface GigabitEthernet0/0",
            " nameif outside",
            " security-level 0",
            f" ip address {ip_wan} {SUBNET_MASK}",
            " no shutdown",
            " exit",
 
            # Interfaz LAN (inside) — nivel de seguridad 100 = más confiable
            "interface GigabitEthernet0/1",
            " nameif inside",
            " security-level 100",
            f" ip address {ip_lan} {SUBNET_MASK}",
            " no shutdown",
            " exit",
 
            "# ── NAT dinámico (PAT) ──",
            # Crear objeto de red para toda la red interna
            "object network LAN_NET",
            f" subnet {'.'.join(ip_lan.split('.')[:3])}.0 {SUBNET_MASK}",
            # NAT dinámico: toda la LAN sale con la IP WAN
            " nat (inside,outside) dynamic interface",
            " exit",
 
            "# ── Política de acceso ──",
            # Permitir tráfico de inside hacia outside
            "access-list INSIDE_OUT extended permit ip any any",
            "access-group INSIDE_OUT in interface inside",
 
            "# ── SSH de gestión ──",
            "crypto key generate rsa modulus 2048",
            "ip ssh version 2",
            f"username {SSH_USER} privilege 15 password {SSH_PASS}",
            # Permitir SSH solo desde la red interna
            f"ssh {'.'.join(ip_lan.split('.')[:3])}.0 255.255.255.0 inside",
            "ssh timeout 10",
            "aaa authentication ssh console LOCAL",
 
            "# ── Ruta por defecto hacia WAN ──",
            "route outside 0.0.0.0 0.0.0.0 " + ".".join(ip_wan.split('.')[:3]) + ".254 1",
        ])
 
        # IPv6 en ASA
        if ipv6:
            dep.extend([
                "# ── IPv6 ──",
                "ipv6 unicast-routing",
                "interface GigabitEthernet0/1",
                f" ipv6 address {ipv6}",
                " ipv6 enable",
                " exit",
            ])
 
        # Protocolos de enrutamiento
        dep.extend(cmds_routing_ipv4("Cisco", proto_v4, ip_lan, as_number, bgp_neighbor))
        dep.extend(cmds_routing_ipv6("Cisco", proto_v6, ipv6, as_number, ospf_router_id))
        dep.extend(["end", "write memory"])
 
        rb.extend([
            "enable", "configure terminal",
            "no interface GigabitEthernet0/0",
            "no interface GigabitEthernet0/1",
            "no object network LAN_NET",
            "no access-list INSIDE_OUT",
            "no crypto key zeroize rsa",
            "end", "write memory",
        ])
 
    # ── HUAWEI USG ─────────────────────────────────────────────────────────
    elif vendor_fw == "Huawei USG":
        dep.extend([
            "system-view",
            f"sysname {host_fw}",
 
            "# ── Zonas de seguridad ──",
            # En Huawei USG la seguridad se organiza por zonas
            "firewall zone untrust",            # Zona WAN = no confiable
            " set priority 5",
            " quit",
            "firewall zone trust",              # Zona LAN = confiable
            " set priority 85",
            " quit",
 
            "# ── Interfaces ──",
            "interface GigabitEthernet0/0/0",
            f" ip address {ip_wan} {SUBNET_MASK}",
            " alias WAN",
            " quit",
            "firewall zone untrust",
            " add interface GigabitEthernet0/0/0",  # Asignar interfaz a zona WAN
            " quit",
 
            "interface GigabitEthernet0/0/1",
            f" ip address {ip_lan} {SUBNET_MASK}",
            " alias LAN",
            " quit",
            "firewall zone trust",
            " add interface GigabitEthernet0/0/1",  # Asignar interfaz a zona LAN
            " quit",
 
            "# ── NAT ──",
            # Crear pool NAT con la IP WAN
            f"nat address-group 1 {ip_wan} {ip_wan}",
            # Política NAT: LAN → WAN con PAT
            "nat-policy interzone trust untrust outbound",
            " policy 1",
            "  action source-nat",
            f"  address-group 1",
            " quit",
            " quit",
 
            "# ── Política de seguridad (permitir LAN → WAN) ──",
            "policy interzone trust untrust outbound",
            " policy 1",
            "  action permit",
            " quit",
            " quit",
 
            "# ── SSH de gestión ──",
            "rsa local-key-pair create",
            "2048",
            "stelnet server enable",
            "aaa",
            f" local-user {SSH_USER} password irreversible-cipher {SSH_PASS}",
            f" local-user {SSH_USER} service-type ssh",
            f" local-user {SSH_USER} privilege level 15",
            " quit",
            "user-interface vty 0 4",
            " authentication-mode aaa",
            " protocol inbound ssh",
            " quit",
        ])
 
        if ipv6:
            dep.extend([
                "# ── IPv6 ──",
                "ipv6",
                "interface GigabitEthernet0/0/1",
                f" ipv6 address {ipv6.replace('/64', ' 64')}",
                " quit",
            ])
 
        dep.extend(cmds_routing_ipv4("Huawei", proto_v4, ip_lan, as_number, bgp_neighbor))
        dep.extend(cmds_routing_ipv6("Huawei", proto_v6, ipv6, as_number, ospf_router_id))
        dep.extend(["return", "save", "y"])
 
        rb.extend([
            "system-view",
            "undo interface GigabitEthernet0/0/0",
            "undo interface GigabitEthernet0/0/1",
            "undo firewall zone untrust",
            "undo firewall zone trust",
            "return", "save", "y",
        ])
 
    # ── FORTINET FGT ───────────────────────────────────────────────────────
    elif vendor_fw == "Fortinet FGT":
        dep.extend([
            "config system global",
            f"    set hostname {host_fw}",
            "end",
 
            "# ── Interfaces ──",
            "config system interface",
            # Interfaz WAN
            "    edit wan1",
            "        set mode static",
            f"        set ip {ip_wan} {SUBNET_MASK}",
            "        set allowaccess ping",
            "    next",
            # Interfaz LAN
            "    edit internal",
            f"        set ip {ip_lan} {SUBNET_MASK}",
            "        set allowaccess ping ssh",  # Permitir SSH en LAN
        ])
        if ipv6:
            dep.extend([
                "        config ipv6",
                f"            set ip6-address {ipv6}",
                "        end",
            ])
        dep.extend([
            "    next",
            "end",
 
            "# ── Política de firewall (LAN → WAN con NAT) ──",
            "config firewall policy",
            "    edit 1",
            "        set name LAN_TO_WAN",
            "        set srcintf internal",
            "        set dstintf wan1",
            "        set srcaddr all",
            "        set dstaddr all",
            "        set action accept",
            "        set schedule always",
            "        set service ALL",
            "        set nat enable",           # NAT habilitado = PAT automático
            "    next",
            "end",
 
            "# ── SSH de gestión ──",
            "config system admin",
            f"    edit {SSH_USER}",
            f"        set password {SSH_PASS}",
            "        set accprofile super_admin",
            "    next",
            "end",
            "config system global",
            "    set admin-ssh-port 22",
            "end",
 
            "# ── Ruta por defecto ──",
            "config router static",
            "    edit 1",
            "        set gateway " + ".".join(ip_wan.split('.')[:3]) + ".254",
            "        set device wan1",
            "    next",
            "end",
        ])
 
        dep.extend(cmds_routing_ipv4("Fortinet", proto_v4, ip_lan, as_number, bgp_neighbor))
        dep.extend(cmds_routing_ipv6("Fortinet", proto_v6, ipv6, as_number, ospf_router_id))
 
        rb.extend([
            "config firewall policy",
            "    delete 1",
            "end",
            "config system interface",
            "    edit wan1",
            "        unset ip",
            "    next",
            "    edit internal",
            "        unset ip",
            "    next",
            "end",
        ])
 
    return dep, rb
 
 
