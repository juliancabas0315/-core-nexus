    usar_ipv6_fw = fw_col5.checkbox(
        "Habilitar IPv6 en LAN del firewall",
        value=False,
        key="usar_ipv6_fw",
        help=(
            "Si activas esta opción, se generará una dirección IPv6 automáticamente "
            "a partir de la IP LAN IPv4.\n\n"
            "Ejemplo: 192.168.0.254 → fd00:A8:00::FE/64\n"
            "  • 'A8' = 168 (segundo octeto) en hex\n"
            "  • '00' = 0 (tercer octeto) en hex\n"
            "  • 'FE' = 254 (cuarto octeto) en hex\n\n"
            "Requiere que el modo IPv6 en el sidebar NO sea 'Sin IPv6'."
        )
    )
    ipv6_fw = None
    if usar_ipv6_fw and not modo_ipv6.startswith("Sin"):
        ipv6_fw = generar_ipv6(ip_lan_fw, modo_ipv6)
        if ipv6_fw:
            st.markdown(f"""
            <div class="cn-info-bar">
                <span class="cn-label">IPv6</span>
                Dirección calculada: <strong style="color:#00d4ff;">{ipv6_fw}</strong>
                &nbsp;·&nbsp; Octetos de {ip_lan_fw} convertidos a hexadecimal
            </div>
            """, unsafe_allow_html=True)
    elif usar_ipv6_fw and modo_ipv6.startswith("Sin"):
        st.markdown("""
        <div class="cn-info-bar" style="border-left-color:#f59e0b; background:rgba(245,158,11,0.05);">
            <span class="cn-label" style="color:#f59e0b;">⚠ Aviso</span>
            Cambia el Modo IPv6 en el sidebar a ULA o Link-Local para habilitar IPv6.
        </div>
        """, unsafe_allow_html=True)

    st.markdown("""
    <div style="margin:16px 0 6px 0;">
        <span style="font-family:'DM Sans',sans-serif; font-size:11px; font-weight:700;
                     text-transform:uppercase; letter-spacing:1.5px; color:#00d4ff;">
            🔀 Protocolos de enrutamiento
        </span>
    </div>
    """, unsafe_allow_html=True)
    fw_pc1, fw_pc2 = st.columns(2)
    fw_proto_v4 = fw_pc1.selectbox("IPv4 Firewall", PROTOCOLOS_IPV4, key="fw_pv4")
    fw_proto_v6 = fw_pc2.selectbox("IPv6 Firewall", PROTOCOLOS_IPV6,
                                    disabled=modo_ipv6.startswith("Sin"), key="fw_pv6")

    fw_as = as_number
    fw_bgp_nb  = bgp_neighbor
    fw_ospf_id = ospf_router_id
    if fw_proto_v4 in ("EIGRP", "BGP"):
        fw_as = st.number_input("AS Firewall", 1, 65535, as_number, key="fw_as")
    if fw_proto_v4 == "BGP":
        fw_bgp_nb = st.text_input("Vecino BGP Firewall", bgp_neighbor, key="fw_bgp")
    if fw_proto_v6 in ("OSPFv3", "EIGRPv6"):
        fw_ospf_id = st.text_input("Router-ID FW", ospf_router_id, key="fw_ospf")

    fw_deploy, fw_rollback = generar_config_firewall(
        vendor_fw, host_fw, ip_wan, ip_lan_fw, ipv6_fw,
        fw_proto_v4, fw_proto_v6, fw_as, fw_bgp_nb, fw_ospf_id
    )
    fw_deploy_txt   = "\n".join(fw_deploy)
    fw_rollback_txt = "\n".join(fw_rollback)

    reporte_fw = (
        f"CORE-NEXUS | {proyecto}\n"
        f"Firewall    : {host_fw} ({vendor_fw})\n"
        f"IP WAN      : {ip_wan}\n"
        f"IP LAN      : {ip_lan_fw}\n"
        f"Proto IPv4  : {fw_proto_v4} | Proto IPv6: {fw_proto_v6}\n"
        f"{'='*50}\n--- DEPLOY ---\n{fw_deploy_txt}\n\n--- ROLLBACK ---\n{fw_rollback_txt}\n"
    )

    st.download_button(
        f"📦 Descargar config Firewall — {host_fw} ({vendor_fw})",
        data=reporte_fw,
        file_name=f"FW_{host_fw}_{proyecto}.txt",
        mime="text/plain",
        use_container_width=True,
        key="dl_fw_main"
    )
    st.divider()

    tfw_dep, tfw_rb = st.tabs(["📄 Deploy Firewall", "⏪ Rollback Firewall"])
    with tfw_dep:
        st.code(fw_deploy_txt, language="bash")
    with tfw_rb:
        st.warning("Ejecutar solo para revertir la configuración del firewall.")
        st.code(fw_rollback_txt, language="bash")

    st.divider()

    # ── Guardar firewall en sesión ──
    if st.button("💾 Guardar firewall en sesión", use_container_width=True, key="save_fw"):
        if st.session_state.sesion_activa is None:
            st.session_state.sesion_activa    = sesion_vacia(proyecto)
            st.session_state.sesion_confirmada = True

        ts_now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        st.session_state.sesion_activa.setdefault("firewalls", []).append({
            "host":         host_fw,
            "vendor":       vendor_fw,
            "ip_wan":       ip_wan,
            "ip_lan":       ip_lan_fw,
            "ipv6":         ipv6_fw if ipv6_fw else "— (sin IPv6)",
            "proto_v4":     fw_proto_v4,
            "proto_v6":     fw_proto_v6,
            "as_number":    fw_as,
            "bgp_neighbor": fw_bgp_nb,
            "ospf_router_id": fw_ospf_id,
            "ts":           ts_now,
        })

        agregar_log(st.session_state.sesion_activa, "FIREWALL",
                    f"Firewall {host_fw} ({vendor_fw}) guardado — WAN: {ip_wan}")
        st.success(f"✅ Firewall {host_fw} guardado en sesión.")


