# =============================================================================
# SISTEMA DE SESIONES DE PROYECTO
# =============================================================================
# Permite guardar la configuración de equipos ya procesados y continuarla
# en otra sesión o desde otro vendor, sin cruzar datos entre grupos.
#
# Estructura de una sesión guardada (en st.session_state):
#   proyecto → nombre del proyecto
#   grupos   → lista de grupos, cada uno con:
#       vendor, num_equipos, vlan_start, host_base,
#       modo_ipv6, proto_v4, proto_v6, modo_ha,
#       equipos: lista de dicts con todos los datos de cada equipo
# =============================================================================

def sesion_vacia(nombre_proyecto: str) -> dict:
    """Devuelve una sesión nueva y vacía para el proyecto dado."""
    return {
        "proyecto":  nombre_proyecto,
        "creada":    datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
        "grupos":    [],          # Un grupo por cada lote de equipos configurado
    }


def agregar_grupo_a_sesion(sesion: dict, vendor: str, red_data: list,
                            vlan_start: int, host_base: str,
                            modo_ipv6: str, proto_v4: str, proto_v6: str,
                            modo_ha: str) -> dict:
    """
    Agrega un grupo de equipos a la sesión activa.

    Cada llamada crea un grupo nuevo con su propio vendor y parámetros,
    de modo que equipos Cisco y Huawei del mismo proyecto no se mezclan.
    Las VLANs y segmentos IP de cada grupo son independientes.

    Args:
        sesion:    Sesión activa (dict)
        vendor:    Fabricante de este grupo
        red_data:  Lista de dicts de equipos calculados
        ...        Resto de parámetros de configuración del grupo

    Returns:
        Sesión actualizada con el nuevo grupo
    """
    grupo = {
        "id":         len(sesion["grupos"]) + 1,
        "vendor":     vendor,
        "vlan_start": vlan_start,
        "host_base":  host_base,
        "modo_ipv6":  modo_ipv6,
        "proto_v4":   proto_v4,
        "proto_v6":   proto_v6,
        "modo_ha":    modo_ha,
        "guardado":   datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "equipos":    [
            {
                "equipo":   r["Equipo"],
                "vlan":     r["VLAN Datos"],
                "ipv4":     r["IPv4 Gateway"],
                "ipv6":     r["IPv6 Gateway"],
                "segmento": r["Segmento"],
            }
            for r in red_data
        ],
    }
    sesion["grupos"].append(grupo)
    return sesion


def vlans_usadas_en_sesion(sesion: dict) -> set:
    """
    Retorna el conjunto de todas las VLANs ya asignadas en la sesión.
    Se usa para detectar conflictos antes de agregar un nuevo grupo.
    """
    vlans = set()
    for g in sesion["grupos"]:
        for eq in g["equipos"]:
            vlans.add(eq["vlan"])
    return vlans


def ips_usadas_en_sesion(sesion: dict) -> set:
    """
    Retorna el conjunto de todas las IPs IPv4 gateway ya asignadas.
    Evita que dos grupos del mismo proyecto usen el mismo segmento.
    """
    ips = set()
    for g in sesion["grupos"]:
        for eq in g["equipos"]:
            ips.add(eq["ipv4"])
    return ips


def exportar_sesion_json(sesion: dict) -> str:
    """Serializa la sesión a JSON legible para descarga."""
    return json.dumps(sesion, indent=2, ensure_ascii=False)


def importar_sesion_json(texto: str) -> dict | None:
    """
    Carga una sesión desde JSON. Retorna None si el formato es inválido.
    Se usa cuando el usuario sube un archivo .json de sesión guardada.
    """
    try:
        datos = json.loads(texto)
        # Validación mínima de estructura
        if "proyecto" in datos and "grupos" in datos:
            return datos
        return None
    except (json.JSONDecodeError, KeyError):
        return None


