def generar_formateo_ssh(vendor):
    """
    Genera SOLO los comandos ejecutables vía SSH para el formateo.
    (Sin comentarios, para envío directo al equipo.)
    """
    if vendor == "Cisco":
        return ["write erase", "delete flash:vlan.dat", "reload"]
    elif vendor == "Huawei":
        return ["reset saved-configuration", "reboot fast"]
    elif vendor == "Fortinet":
        return ["execute factoryreset"]
    return []


