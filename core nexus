        dep.extend(cmds_routing_ipv6("Fortinet", proto_v6, ipv6, as_number, ospf_router_id))
        rb.extend([
            "config firewall policy", "    delete 1", "end",
            "config system interface",
            "    edit wan1", "        unset ip", "    next",
            "    edit internal", "        unset ip", "    next", "end",
        ])

    return dep, rb


