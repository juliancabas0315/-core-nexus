def generar_config_router(vendor: str, ipv4: str, ipv6: str | None,
                           host: str, proto_v4: str, proto_v6: str,
                           as_number: int, bgp_neighbor: str,
                           bgp_neighbor_as: int, ospf_router_id: str,
                           cmds_admin_precalc: list,
                           vlan_admin: int, ip_admin: str,
                           modo_ha: str = "Ninguno",
                           ip_respaldo: str = "0.0.0.0",
                           es_activo: bool = True) -> tuple:
    dep, rb = [], []
    ip_wan_gw = f"{IP_BASE_1}.{IP_BASE_2}.{IP_ADMIN_OCTETO}.254"

    if vendor == "Cisco":
        dep.extend(["enable", "configure terminal", f"hostname {host}", "# ── Gestión SSH ──"])
        dep.extend(cmds_admin_precalc)
        dep.extend([
            "interface GigabitEthernet0/0",
            f" ip address {ipv4} {SUBNET_MASK}",
            " description LAN", " no shutdown",
        ])
        if ipv6:
            dep.extend([f" ipv6 address {ipv6.split('/')[0]}/64", " ipv6 enable"])
        dep.extend([
            " exit",
            "interface GigabitEthernet0/1",
            f" ip address {ip_wan_gw} {SUBNET_MASK}",
            " description WAN", " no shutdown", " exit",
            f"ip route 0.0.0.0 0.0.0.0 {ip_wan_gw}",
        ])
        dep.extend(cmds_routing_ipv4(vendor, proto_v4, ipv4, as_number, bgp_neighbor, bgp_neighbor_as))
        dep.extend(cmds_routing_ipv6(vendor, proto_v6, ipv6, as_number, ospf_router_id))
        if modo_ha in ("IP SLA + Ruta Flotante", "Completo"):
            dep.extend([
                f"ip sla {IPSLA_NUM}",
                f" icmp-echo {ip_respaldo} source-interface GigabitEthernet0/0",
                " frequency 5", " exit",
                f"ip sla schedule {IPSLA_NUM} life forever start-time now",
                f"track {TRACK_NUM} ip sla {IPSLA_NUM} reachability",
                f"ip route 0.0.0.0 0.0.0.0 {ip_respaldo} 1 track {TRACK_NUM}",
                f"ip route 0.0.0.0 0.0.0.0 {ip_respaldo} 254",
            ])
        dep.extend(["end", "write memory"])
        rb.extend([
            "enable", "configure terminal",
            "no interface GigabitEthernet0/0", "no interface GigabitEthernet0/1",
            f"no ip route 0.0.0.0 0.0.0.0 {ip_wan_gw}",
            f"no ip sla {IPSLA_NUM}", f"no track {TRACK_NUM}",
            "end", "write memory",
        ])

    elif vendor == "Huawei":
        dep.extend(["system-view", f"sysname {host}"])
        if ipv6:
            dep.append("ipv6")
        dep.extend(cmds_admin_precalc)
        dep.extend([
            "interface GigabitEthernet0/0/0",
            f" ip address {ipv4} {SUBNET_MASK}", " description LAN",
        ])
        if ipv6:
            dep.append(f" ipv6 address {ipv6.replace('/64', ' 64')}")
        dep.extend([
            " quit",
            "interface GigabitEthernet0/0/1",
            f" ip address {ip_wan_gw} {SUBNET_MASK}", " description WAN", " quit",
            f"ip route-static 0.0.0.0 0 {ip_wan_gw}",
        ])
        dep.extend(cmds_routing_ipv4(vendor, proto_v4, ipv4, as_number, bgp_neighbor, bgp_neighbor_as))
        dep.extend(cmds_routing_ipv6(vendor, proto_v6, ipv6, as_number, ospf_router_id))
        if modo_ha in ("IP SLA + Ruta Flotante", "Completo"):
            dep.extend([
                f"nqa test-instance admin SLA_{IPSLA_NUM}",
                "  test-type icmp",
                f"  destination-address ipv4 {ip_respaldo}",
                f"  source-address ipv4 {ipv4}",
                "  frequency 5", "  probe-count 3", "  start now", " quit",
                f"track {TRACK_NUM} nqa admin SLA_{IPSLA_NUM} probe-fail",
                f"ip route-static 0.0.0.0 0 {ip_respaldo} preference 1 track {TRACK_NUM}",
                f"ip route-static 0.0.0.0 0 {ip_respaldo} preference 254",
            ])
        dep.extend(["return", "save", "y"])
        rb.extend([
            "system-view",
            "undo interface GigabitEthernet0/0/0", "undo interface GigabitEthernet0/0/1",
            f"undo ip route-static 0.0.0.0 0 {ip_wan_gw}",
            "return", "save", "y",
        ])

    elif vendor == "Fortinet":
        dep.extend(["config system global", f"    set hostname {host}", "end"])
        dep.extend(cmds_admin_precalc)
        dep.extend([
            "config system interface",
            "    edit internal",
            "        set mode static",
            f"        set ip {ipv4} {SUBNET_MASK}",
            "        set allowaccess ping ssh", "        set description LAN",
        ])
        if ipv6:
            dep.extend(["        config ipv6", f"            set ip6-address {ipv6}", "        end"])
        dep.extend([
            "    next", "    edit wan1",
            "        set mode static",
            f"        set ip {ip_wan_gw} {SUBNET_MASK}",
            "        set allowaccess ping", "        set description WAN",
            "    next", "end",
            "config router static", "    edit 1",
            f"        set gateway {ip_wan_gw}", "        set device wan1",
            "    next", "end",
        ])
        dep.extend(cmds_routing_ipv4(vendor, proto_v4, ipv4, as_number, bgp_neighbor, bgp_neighbor_as))
        dep.extend(cmds_routing_ipv6(vendor, proto_v6, ipv6, as_number, ospf_router_id))
        if modo_ha in ("IP SLA + Ruta Flotante", "Completo"):
            dep.extend([
                "config system link-monitor",
                f"    edit MONITOR_RT",
                "        set srcintf internal",
                f"        set server {ip_respaldo}",
                "        set interval 5", "        set failtime 3",
                "        set update-static-route enable",
                "    next", "end",
            ])
        rb.extend([
            "config system interface",
            "    edit internal", "        unset ip", "    next",
            "    edit wan1", "        unset ip", "    next", "end",
            "config router static", "    delete 1", "end",
        ])

    return dep, rb


