import ipaddress

def generar_herramienta_red(ip_base_str):
    try:
        # 1. Validación y Creación del objeto IP
        ip_obj = ipaddress.IPv4Address(ip_base_str)
        octetos = str(ip_obj).split('.')
        
        # 2. Clase de la IP e IPs Reservadas
        primer_octeto = int(octetos[0])
        if 1 <= primer_octeto <= 126:
            clase = "A"
            reservada = "Privada (10.0.0.0)" if primer_octeto == 10 else "Pública"
        elif 128 <= primer_octeto <= 191:
            clase = "B"
            reservada = "Privada (172.16.0.0)" if (primer_octeto == 172 and 16 <= int(octetos[1]) <= 31) else "Pública"
        elif 192 <= primer_octeto <= 223:
            clase = "C"
            reservada = "Privada (192.168.0.0)" if (primer_octeto == 192 and int(octetos[1]) == 168) else "Pública"
        else:
            clase = "D/E"
            reservada = "Multicast/Experimental"

        # 3. Conversión a IPv6 (6to4)
        # Se toma el formato 2002:WWXX:YYZZ::/48
        ipv6_6to4 = f"2002:{int(octetos[0]):02x}{int(octetos[1]):02x}:{int(octetos[2]):02x}{int(octetos[3]):02x}::1"

        print(f"--- ANÁLISIS DE IP: {ip_base_str} ---")
        print(f"Octetos: | {octetos[0]} | {octetos[1]} | {octetos[2]} | {octetos[3]} |")
        print(f"Estado: Válida | Clase: {clase} | Tipo: {reservada}")
        print(f"Conversión IPv6 (6to4): {ipv6_6to4}\n")

        # 4. Segmentación VLAN para 5 Pisos (VLSM simplificado)
        print(f"{'PISO':<8} | {'VLAN':<5} | {'SUBRED':<15} | {'HOSTS':<8} | {'POOL DHCP':<25} | {'DNS'}")
        print("-" * 85)
        
        dns_list = ["8.8.8.8", "8.8.4.4", "1.1.1.1", "1.0.0.1", "9.9.9.9"]
        
        for i in range(1, 6):
            # Simulamos segmentos cambiando el tercer octeto para el ejemplo
            subred = f"{octetos[0]}.{octetos[1]}.{i * 10}.0/24"
            red = ipaddress.IPv4Network(subred)
            pool = f"{list(red.hosts())[9]} - {list(red.hosts())[-1]}" # Salta las primeras 10 IPs para equipos fijos
            
            print(f"Piso {i:<3} | {i*10:<5} | {subred:<15} | {red.num_addresses - 2:<8} | {pool:<25} | {dns_list[i-1]}")

    except ValueError:
        print("Error: La dirección IPv4 proporcionada no es válida.")

# --- EJECUCIÓN ---
ip_usuario = input("Introduce la IP IPv4 (ej. 192.168.1.1): ")
generar_herramienta_red(ip_usuario)
