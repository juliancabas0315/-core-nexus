        elif nivel == "Reset de Fábrica":
            cmds.extend([
                "enable", "write erase", "delete flash:vlan.dat", "reload",
            ])

    elif vendor == "Huawei":
        if nivel == "Limpieza Selectiva":
            cmds.extend(["system-view", ""])
            for v in vlan_datos_list:
                cmds.extend([f"undo interface Vlanif{v}", f"undo vlan {v}"])
            cmds.extend([
                "undo rip 1", "undo ospf 1", "undo ospfv3 1", "undo ripng 1",
