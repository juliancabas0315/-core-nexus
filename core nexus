def generar_ipv6(ipv4: str, modo: str) -> str | None:
    """
    Genera una dirección IPv6 válida a partir de una IPv4, según el modo elegido.
 
    Modos disponibles:
      - "ULA (fd00::/8) — Recomendado":
            Equivalente IPv6 de 192.168.x.x. Enrutable entre VLANs localmente.
            Fórmula: fd00:a8:<tercer_octeto>::<cuarto_octeto>/64
            Ejemplo: 192.168.3.1 → fd00:a8:3::1/64
            'a8' es 168 en hexadecimal (segundo octeto fijo de 192.168.x.x)
 
      - "Link-Local (fe80::) — Solo mismo segmento":
            Todo equipo la genera automáticamente. NO es enrutable entre VLANs.
            Se configura igual en todos los equipos: fe80::1/64 por interfaz.
            Útil solo si no necesitas comunicación inter-VLAN por IPv6.
 
      - "Sin IPv6 — Solo IPv4":
            No genera dirección IPv6. Los scripts omiten toda configuración IPv6.
            La opción más simple si aún no usas IPv6 en producción.
 
    Args:
        ipv4: Dirección IPv4 del gateway (ej: "192.168.3.1")
        modo: Uno de los tres modos descritos arriba.
 
    Returns:
        String con la dirección IPv6 y prefijo, o None si el modo es "Sin IPv6".
    """
    # Separar la IPv4 en sus 4 partes: ["192", "168", "3", "1"]
    p = ipv4.split('.')
 
    # Convertir a entero el tercer octeto (subred) y el cuarto (host)
    tercer = int(p[2])   # ej: 3  → identifica el segmento de red
    cuarto = int(p[3])   # ej: 1  → identifica el host (gateway)
 
    # 168 en hexadecimal es "a8". Se usa como parte fija del prefijo ULA
    # porque nuestras IPs siempre tienen 168 como segundo octeto (192.168.x.x)
    hex_168 = "a8"
 
    if modo.startswith("ULA"):
        # :x formatea el entero como hexadecimal sin prefijo 0x
        # Resultado ejemplo: fd00:a8:3::1/64
        return f"fd00:{hex_168}:{tercer:x}::{cuarto:x}/64"
 
    elif modo.startswith("Link-Local"):
        # fe80:: es el prefijo reservado para Link-Local (RFC 4291)
        # Solo se usa el cuarto octeto como identificador del host
        # Resultado ejemplo: fe80::1/64
        return f"fe80::{cuarto:x}/64"
 
    else:
        # Modo "Sin IPv6": devuelve None para que los scripts omitan esas líneas
        return None
 
 
# -----------------------------------------------------------------------------
 
def generar_config_equipo(vendor: str, vlan: int, nombre: str,
                           ipv4: str, ipv6: str | None, host: str) -> tuple:
    """
    Genera los comandos de deploy y rollback para UN solo equipo/segmento.
 
    Args:
        vendor: Fabricante. Valores: "Cisco", "Huawei", "Fortinet"
        vlan:   ID de VLAN
        nombre: Nombre descriptivo de la VLAN
        ipv4:   Dirección IPv4 del gateway
        ipv6:   Dirección IPv6 del gateway, o None si no se usa IPv6
        host:   Hostname del equipo
 
    Returns:
        deploy:   Lista de comandos para aplicar la configuración
        rollback: Lista de comandos para revertir (deshacer) los cambios
    """
    # dep = lista de comandos de despliegue (deploy)
    # rb  = lista de comandos de reversión (rollback)
    dep, rb = [], []
 
    # -------------------------------------------------------------------------
    # BLOQUE CISCO IOS
    # -------------------------------------------------------------------------
    if vendor == "Cisco":
 
        # --- Comandos iniciales ---
        dep.extend([
            "enable",                    # Entrar al modo privilegiado
            "configure terminal",        # Entrar al modo de configuración global
            f"hostname {host}",          # Asignar nombre al equipo
 
            # Excluir las primeras IPs del rango DHCP para no asignarlas a clientes
            # (se reservan para gateways, servidores, impresoras, etc.)
            f"ip dhcp excluded-address {IP_BASE_1}.{IP_BASE_2}.0.1 "
            f"{IP_BASE_1}.{IP_BASE_2}.0.10",
 
            # Crear la VLAN con su nombre descriptivo
            f"vlan {vlan}",
            f" name {nombre}",
            " exit",
 
            # Configurar la interfaz virtual de la VLAN (SVI = Switch Virtual Interface)
            # Esta interfaz actúa como gateway para los dispositivos de esa VLAN
            f"interface vlan {vlan}",
            f" ip address {ipv4} {SUBNET_MASK}",  # Asignar IP y máscara al gateway
        ])
 
        # Solo agregar la línea IPv6 si el modo no es "Sin IPv6"
        # ipv6.split('/')[0] extrae solo la dirección sin el prefijo /64
        if ipv6:
            dep.append(f" ipv6 address {ipv6.split('/')[0]}/64")
 
        dep.extend([
            " no shut",                  # Activar la interfaz (por defecto está apagada)
            " exit",
 
            # Crear el pool DHCP que asignará IPs automáticamente a los clientes
            f"ip dhcp pool POOL_{vlan}",
 
            # ipv4[:-1] quita el último caracter de la IP ("1" del gateway)
            # y añade "0" para obtener la dirección de red. Ej: 192.168.3.1 → 192.168.3.0
            f" network {ipv4[:-1]}0 {SUBNET_MASK}",
 
            f" default-router {ipv4}",   # Indicar a los clientes cuál es el gateway
            f" dns-server {DNS_PRIMARIO}", # Indicar el servidor DNS a los clientes
            " exit",
            "end",                       # Salir del modo de configuración
            "write memory"               # Guardar la configuración en memoria no volátil
        ])
 
        # Comandos para DESHACER todo lo anterior (rollback)
        rb.extend([
            "enable",
            "configure terminal",
            f"no ip dhcp pool POOL_{vlan}",   # Eliminar el pool DHCP
            f"no interface vlan {vlan}",       # Eliminar la interfaz virtual
            f"no vlan {vlan}",                 # Eliminar la VLAN
            "end",
            "write memory"
        ])
 
    # -------------------------------------------------------------------------
    # BLOQUE HUAWEI VRP
    # -------------------------------------------------------------------------
    elif vendor == "Huawei":
 
        # Entrar al modo de configuración global (equivalente a "configure terminal")
        dep.extend(["system-view", f"sysname {host}"])
 
        # En Huawei, IPv6 debe habilitarse globalmente antes de usarlo en interfaces
        if ipv6:
            dep.append("ipv6")           # Habilitar IPv6 en el sistema
 
        dep.extend([
            "dhcp enable",               # Habilitar el servicio DHCP globalmente
 
            # Crear la VLAN
            f"vlan {vlan}",
            f" description {nombre}",    # En Huawei se usa "description" en lugar de "name"
            " quit",                     # En Huawei se usa "quit" en lugar de "exit"
 
            # Interfaz VLAN (Vlanif = VLAN Interface, equivalente a "interface vlan" en Cisco)
            f"interface Vlanif{vlan}",
            f" ip address {ipv4} {SUBNET_MASK}",
        ])
 
        if ipv6:
            # Huawei usa espacio en lugar de "/" para separar dirección y prefijo
            # Ejemplo: "fd00:a8:3::1 64" en lugar de "fd00:a8:3::1/64"
            dep.append(f" ipv6 address {ipv6.replace('/64', ' 64')}")
 
        dep.extend([
            # DHCP "select interface" significa: usar la IP de esta interfaz
            # como rango base para asignar IPs a los clientes (no necesita pool separado)
            " dhcp select interface",
            " quit",
            "return",                    # Volver al modo usuario (equivalente a "end")
            "save",                      # Guardar configuración
            "y"                          # Confirmar el guardado (Huawei pide confirmación)
        ])
 
        # Rollback: deshacer en orden inverso (primero interfaz, luego VLAN)
        rb.extend([
            "system-view",
            f"undo interface Vlanif{vlan}",  # "undo" es el equivalente a "no" en Huawei
            f"undo vlan {vlan}",
            "return",
            "save",
            "y"
        ])
 
    # -------------------------------------------------------------------------
    # BLOQUE FORTINET FORTIOS
    # -------------------------------------------------------------------------
    elif vendor == "Fortinet":
 
        dep.extend([
            # Configurar parámetros globales del sistema
            "config system global",
            f"    set hostname {host}",
            "end",
 
            # Acceder al bloque de configuración de interfaces
            "config system interface",
 
            # "edit" crea o edita una interfaz con ese nombre
            f"    edit vlan{vlan}",
            "        set vdom root",                   # Asignar al dominio virtual "root"
            f"        set ip {ipv4} {SUBNET_MASK}",    # IP y máscara de la interfaz
            f"        set vlanid {vlan}",               # ID de la VLAN (etiqueta 802.1Q)
            "        set interface internal",           # Interfaz física padre
        ])
 
        # En Fortinet, IPv6 se configura dentro de un sub-bloque "config ipv6"
        if ipv6:
            dep.extend([
                "        config ipv6",
                f"            set ip6-address {ipv6}",  # Dirección IPv6 completa con prefijo
                "        end",                          # Cerrar sub-bloque IPv6
            ])
 
        dep.extend([
            "    next",   # Finalizar la edición de esta interfaz y pasar a la siguiente
            "end"         # Cerrar el bloque "config system interface"
        ])
 
        # Rollback: eliminar la interfaz VLAN creada
        rb.extend([
            "config system interface",
            f"    delete vlan{vlan}",   # Eliminar la interfaz por nombre
            "end"
        ])
 
    # Devolver ambas listas como una tupla: (deploy, rollback)
    return dep, rb
 
 
# =============================================================================
# INTERFAZ DE USUARIO — STREAMLIT
# =============================================================================
# A partir de aquí todo es código de UI. Streamlit ejecuta estas líneas
# de arriba a abajo cada vez que el usuario interactúa con cualquier control.
 
st.title("🛡️ CORE-NEXUS: Enterprise Network Engine")
st.caption("Sistema de Automatización de Redes e Infraestructura de Telecomunicaciones")
 
 
# Lista de modos IPv6 disponibles. Se usa en el selectbox del sidebar
# y también en generar_ipv6() para decidir qué tipo de dirección producir.
MODOS_IPV6 = [
    "ULA (fd00::/8) — Recomendado",
    "Link-Local (fe80::) — Solo mismo segmento",
    "Sin IPv6 — Solo IPv4",
]
 
 
# -----------------------------------------------------------------------------
# SIDEBAR — Panel de configuración izquierdo
# -----------------------------------------------------------------------------
# Todo lo que esté dentro del bloque "with st.sidebar:" aparece en el panel
# lateral izquierdo de la app, no en el área principal.
with st.sidebar:
    st.header("⚙️ Configuración Maestro")
 
    # Campo de texto para el nombre del proyecto.
    # El segundo argumento es el valor por defecto que aparece al iniciar la app.
    proyecto = st.text_input("Nombre del Proyecto", "FIBERTEC_OP_2026")
 
    # Lista desplegable para elegir el fabricante del equipo.
    # El valor seleccionado determina qué bloque de comandos genera generar_config_equipo()
    vendor = st.selectbox("Fabricante Core", ["Cisco", "Huawei", "Fortinet"])
 
    st.divider()  # Línea horizontal separadora visual
 
    # Lista desplegable para elegir el modo de IPv6.
    # El valor se pasa a generar_ipv6() para calcular la dirección correcta.
    modo_ipv6 = st.selectbox("Modo IPv6", MODOS_IPV6)
 
    # Mostrar una explicación contextual según el modo elegido.
    # startswith() compara solo el inicio del string para evitar
    # depender del texto completo de la opción.
    if modo_ipv6.startswith("ULA"):
        st.caption("✅ Equivalente a 192.168.x.x en IPv6. Enrutable entre VLANs.")
        st.caption("Ejemplo: 192.168.3.1 → **fd00:a8:3::1/64**")
    elif modo_ipv6.startswith("Link-Local"):
        st.caption("⚠️ Solo funciona dentro del mismo segmento. No cruza VLANs.")
        st.caption("Ejemplo: fe80::1/64 por interfaz")
    else:
        st.caption("ℹ️ Los scripts no incluirán ninguna configuración IPv6.")
 
    st.divider()
    st.caption("🌐 Base de red fija: **192.168.x.1**")  # Recordatorio visual, no editable
 
 
# -----------------------------------------------------------------------------
# CONTROLES PRINCIPALES — Área central de la app
# -----------------------------------------------------------------------------
# st.columns(3) divide el área en 3 columnas iguales para poner los inputs lado a lado.
c_a, c_b, c_c = st.columns(3)
 
# Cantidad de equipos a configurar. Determina cuántas filas genera el loop de redes.
# Parámetros: (etiqueta, valor_mínimo, valor_máximo, valor_por_defecto)
num_equipos = c_a.number_input("N° de Equipos / Segmentos", 1, SEGMENTOS_MAX, 3)
 
# Prefijo del hostname. Se combina con el número de equipo: "CORE-SW-01", "CORE-SW-02"...
host_base = c_b.text_input("Prefijo Hostname", "CORE-SW")
 
# VLAN inicial. Las siguientes VLANs se incrementan de 10 en 10.
# Ejemplo con valor 100: VLAN 100, 110, 120, 130...
vlan_start = c_c.number_input("VLAN ID Inicial", VLAN_ID_MIN, VLAN_ID_MAX, 100, step=10)
 
 
# -----------------------------------------------------------------------------
# CÁLCULO AUTOMÁTICO DE REDES
# -----------------------------------------------------------------------------
# Este loop construye la lista "red_data" con un diccionario por cada equipo.
# Cada diccionario contiene todos los datos de red de ese equipo.
 
red_data = []  # Lista vacía que se llenará con un dict por equipo
 
for i in range(num_equipos):
    # i empieza en 0, pero los segmentos empiezan en 1.
    # Equipo 1 → 192.168.1.x, Equipo 2 → 192.168.2.x, etc.
    tercer_octeto = i + 1
 
    # Construir la IP del gateway: siempre termina en .1 (el primer host de la subred)
    gw = f"{IP_BASE_1}.{IP_BASE_2}.{tercer_octeto}.1"
 
    # Calcular el ID de VLAN: incrementa de 10 en 10 desde el valor inicial
    # Ejemplo con vlan_start=100: 100, 110, 120, 130...
    vlan = vlan_start + (i * 10)
 
    # Generar la dirección IPv6 según el modo elegido en el sidebar
    # Puede devolver None si el modo es "Sin IPv6"
    ipv6 = generar_ipv6(gw, modo_ipv6)
 
    # Agregar el equipo a la lista con todos sus datos
    red_data.append({
        # zfill(2) agrega un cero a la izquierda si el número tiene un solo dígito
        # Ejemplo: 1 → "01", 10 → "10"
        "Equipo":       f"{host_base}-{str(i+1).zfill(2)}",
        "Segmento":     f"Segmento {i+1}",
        "VLAN":          vlan,
        "Nombre VLAN":  f"VLAN_{vlan}",
        "IPv4 Gateway":  gw,
        # Si ipv6 es None (modo sin IPv6), mostrar "— (sin IPv6)" en la tabla
        "IPv6 Gateway":  ipv6 if ipv6 else "— (sin IPv6)",
    })
 
# Convertir la lista de diccionarios en un DataFrame de pandas para mostrarlo como tabla
df_red = pd.DataFrame(red_data)
 
 
# -----------------------------------------------------------------------------
# VISUALIZACIÓN DE MÉTRICAS Y TABLA
# -----------------------------------------------------------------------------
 
st.subheader("🌐 Gateways Asignados Automáticamente")
 
# Crear hasta 4 columnas para las tarjetas de métrica.
# min() evita crear más columnas que equipos (si hay solo 2, no crear 4 columnas vacías)
cols_gw = st.columns(min(num_equipos, 4))
 
for idx, r in enumerate(red_data):
    # idx % 4 asegura que al tener más de 4 equipos, se reutilicen las columnas
    # Ejemplo: equipos 0,1,2,3 van en cols 0,1,2,3; el equipo 4 vuelve a col 0
    with cols_gw[idx % 4]:
        # st.metric muestra una tarjeta con: etiqueta arriba, valor grande, delta abajo
        st.metric(r["Equipo"], r["IPv4 Gateway"], f"VLAN {r['VLAN']}")
 
# Mostrar la tabla completa con todos los datos calculados
st.table(df_red)
 
st.divider()
 
 
# =============================================================================
# SECCIÓN DE SCRIPTS POR EQUIPO
# =============================================================================
 
# Extraer la parte descriptiva del modo IPv6 para el subtítulo de la sección
# Ejemplo: "ULA (fd00::/8) — Recomendado" → "Recomendado"
ipv6_label = modo_ipv6.split("—")[-1].strip()
st.subheader(f"📋 Scripts de Configuración — {num_equipos} Equipo(s) | {vendor} | IPv6: {ipv6_label}")
 
 
def _ipv6_real(r: dict) -> str | None:
    """
    Extrae el valor IPv6 real de un dict de red_data.
 
    El problema: red_data guarda "— (sin IPv6)" como string cuando no hay IPv6,
    pero generar_config_equipo() espera None (no un string) para omitir las líneas.
    Esta función hace la conversión antes de llamar a generar_config_equipo().
 
    Args:
        r: Diccionario de un equipo de red_data
 
    Returns:
        La dirección IPv6 como string, o None si no aplica
    """
    v = r["IPv6 Gateway"]
    return None if v == "— (sin IPv6)" else v
 
 
# -----------------------------------------------------------------------------
# BOTÓN DE DESCARGA MASIVA (todos los equipos en un solo archivo)
# -----------------------------------------------------------------------------
 
# Construir el contenido del archivo de texto con todos los scripts
lineas_todo = [f"CORE-NEXUS REPORT COMPLETO: {proyecto}", "=" * 50, ""]
 
for r in red_data:
    # Generar los scripts para este equipo
    dep, rb = generar_config_equipo(
        vendor, r["VLAN"], r["Nombre VLAN"],
        r["IPv4 Gateway"], _ipv6_real(r), r["Equipo"]
    )
 
    # Agregar encabezado separador para identificar cada equipo en el archivo
    lineas_todo.append(f"{'='*50}")
    lineas_todo.append(f"EQUIPO: {r['Equipo']}  |  {r['IPv4 Gateway']}  |  VLAN {r['VLAN']}")
    lineas_todo.append(f"IPv6: {r['IPv6 Gateway']}")
    lineas_todo.append(f"{'='*50}")
 
    # Agregar los comandos de deploy y rollback separados por etiqueta
    lineas_todo.append("--- DEPLOY ---")
    lineas_todo.extend(dep)      # extend agrega cada elemento de la lista por separado
    lineas_todo.append("")       # Línea en blanco como separador
 
    lineas_todo.append("--- ROLLBACK ---")
    lineas_todo.extend(rb)
    lineas_todo.append("")
 
# Botón que genera el archivo .txt y lo ofrece para descargar.
# Streamlit convierte "\n".join(lineas_todo) en un archivo descargable al hacer clic.
st.download_button(
    label="📦 Descargar scripts de TODOS los equipos (.txt)",
    data="\n".join(lineas_todo),               # Unir todas las líneas con salto de línea
    file_name=f"CORE_NEXUS_{proyecto}_COMPLETO.txt",
    mime="text/plain",
    use_container_width=True                   # El botón ocupa todo el ancho disponible
)
 
st.divider()
 
 
# -----------------------------------------------------------------------------
# EXPANDERS INDIVIDUALES — Un panel desplegable por equipo
# -----------------------------------------------------------------------------
# Cada expander muestra el script de deploy, el rollback y el botón de descarga
# individual para ese equipo. Por defecto están colapsados (expanded=False).
 
for r in red_data:
    # Generar los scripts CLI para este equipo específico
    deploy, rollback = generar_config_equipo(
        vendor, r["VLAN"], r["Nombre VLAN"],
        r["IPv4 Gateway"], _ipv6_real(r), r["Equipo"]
    )
 
    # Convertir las listas de comandos a texto plano con saltos de línea
    deploy_txt   = "\n".join(deploy)
    rollback_txt = "\n".join(rollback)
 
    # Construir el texto completo del reporte individual para descarga
    reporte_equipo = (
        f"CORE-NEXUS | {proyecto}\n"
        f"Equipo : {r['Equipo']}\n"
        f"Gateway IPv4: {r['IPv4 Gateway']} | VLAN {r['VLAN']}\n"
        f"Gateway IPv6: {r['IPv6 Gateway']}\n"
        f"{'='*40}\n"
        f"--- DEPLOY ---\n{deploy_txt}\n\n"
        f"--- ROLLBACK ---\n{rollback_txt}\n"
    )
 
    # Crear el panel desplegable. El título muestra los datos clave del equipo
    # para identificarlo sin necesidad de abrirlo.
    with st.expander(
        f"🖧  {r['Equipo']}  —  {r['IPv4 Gateway']}  —  {r['IPv6 Gateway']}  —  VLAN {r['VLAN']}",
        expanded=False  # Arranca colapsado; el usuario lo abre si le interesa
    ):
        # Dos pestañas dentro del expander: una para deploy, otra para rollback
        t_dep, t_rb = st.tabs(["📄 Deploy", "⏪ Rollback"])
 
        with t_dep:
            # st.code muestra el texto con fuente monoespaciada y botón de copiar
            st.code(deploy_txt, language="bash")
 
        with t_rb:
            st.warning("Ejecutar solo para revertir cambios.")  # Aviso en amarillo
            st.code(rollback_txt, language="bash")
 
        # Botón de descarga individual para este equipo.
        # IMPORTANTE: el parámetro key debe ser único por cada botón en la página.
        # Sin key único, Streamlit lanza un error al tener múltiples botones iguales.
        st.download_button(
            label=f"💾 Descargar script — {r['Equipo']}",
            data=reporte_equipo,
