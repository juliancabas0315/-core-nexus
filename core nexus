        "vlans_globales": [],
        "log": [],   # registro cronológico de acciones
    }


def exportar_sesion_json(sesion: dict) -> str:
    return json.dumps(sesion, indent=2, ensure_ascii=False)


def importar_sesion_json(texto: str) -> dict | None:
    try:
        datos = json.loads(texto)
        if "proyecto" in datos:
            return datos
        return None
    except (json.JSONDecodeError, KeyError):
        return None


def agregar_log(sesion: dict, tipo: str, descripcion: str):
    sesion.setdefault("log", []).append({
        "ts": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "tipo": tipo,
        "desc": descripcion,
    })


