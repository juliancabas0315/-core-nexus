import ipaddress
from netmiko import ConnectHandler

class NetworkManager:
    def __init__(self, ip_base, num_pisos):
        self.ip_base = ipaddress.IPv4Interface(ip_base)
        self.num_pisos = num_pisos
        self.config_log = [] # Para Rollback

    def generar_segmentacion(self):
        """Calcula la red para cada piso de forma dinámica"""
        segmentos = []
        for i in range(1, self.num_pisos + 1):
            # Creamos subredes basadas en el piso (ej. 192.168.10.0, 20.0...)
            red_piso = f"{self.ip_base.ip + (i * 256)}" # Lógica simple de salto
            segmentos.append({
                "piso": i,
                "vlan": i * 10,
                "red": red_piso,
                "gateway": f"{red_piso[:-1]}1"
            })
        return segmentos

    def push_config(self, device_data, comandos):
        """Envia la configuración con manejo de errores (Rollback)"""
        try:
            with ConnectHandler(**device_data) as net_connect:
                net_connect.enable()
                output = net_connect.send_config_set(comandos)
                print(f"✅ Éxito en {device_data['host']}")
                return True
        except Exception as e:
            print(f"❌ ERROR en {device_data['host']}: {e}")
            self.ejecutar_rollback(device_data)
            return False

    def ejecutar_rollback(self, device_data):
        """Lógica para revertir cambios en caso de falla"""
        print(f"⚠️ Iniciando Rollback preventivo en {device_data['host']}...")
        # Aquí podrías cargar un 'checkpoint' previo o comandos 'no vlan X'
        pass

# --- BLOQUE DE PLANTILLAS POR MARCA ---
def get_commands(marca, vlan, gateway):
    templates = {
        "cisco_ios": [f"vlan {vlan}", f"name PISO_{vlan//10}", "exit"],
        "huawei": [f"vlan {vlan}", "quit", f"interface Vlanif {vlan}"],
        "fortinet": [f"config system interface", f"edit vlan{vlan}", "set vdom root"]
    }
    return templates.get(marca, [])

# --- EJECUCIÓN PRINCIPAL ---
if __name__ == "__main__":
    pisos = int(input("¿Cuántos pisos deseas configurar? "))
    ip_init = "192.168.0.0/24"
    
    manager = NetworkManager(ip_init, pisos)
    plan = manager.generar_segmentacion()

    # Ejemplo de Host a configurar
    mi_switch = {
        'device_type': 'cisco_ios', # Cambiar a 'huawei' o 'fortinet' según sea el caso
        'host': '10.0.0.5',
        'username': 'admin',
        'password': 'password123',
    }

    for p in plan:
        cmds = get_commands(mi_switch['device_type'], p['vlan'], p['gateway'])
        manager.push_config(mi_switch, cmds)
